# AI CRM Demo - Portfolio environment example
# Copy to backend/.env and edit if you want to override any default.
# All values in this file are placeholders; no real credentials are shipped.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Set DB_ENGINE=sqlite to skip PostgreSQL entirely
# (only supported when DJANGO_SETTINGS_MODULE=config.settings.demo).
DB_ENGINE=postgres
DB_NAME=ai_crm_demo
DB_USER=ai_crm_demo
DB_PASSWORD=ai_crm_demo
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Portfolio Demo mode. Keep AI_PROVIDER=mock unless you have a real
# Anthropic key and understand that requests will hit the paid API.
DEMO_MODE=true
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# File Storage
FILE_STORAGE=local
MEDIA_ROOT=media

# Logging
LOG_LEVEL=INFO
