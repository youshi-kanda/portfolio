---
/**
 * 06 FOOTER — who this is and what you are looking at. Nothing is asked here.
 *
 * Split from CONTACT in #7. They had been one band doing two jobs, and the
 * second one quietly weakened the first: a section that asks for work reads
 * differently when the same box also carries the mark, the version and the
 * repository. CONTACT now closes the argument; this closes the document.
 */
import { site } from '../../lib/content/site.ts';

const year = new Date().getUTCFullYear();
---

<footer class="foot" id="footer">
  <div class="page">
    <div class="in">
      <p class="mark">{site.handle}</p>
      <p class="ft-m">
        <a href={site.repo}>{site.repo.replace(/^https?:\/\//, '')}</a>
        <span class="sep">·</span>
        <span>v4</span>
        <span class="sep">·</span>
        <span>© {year}</span>
      </p>
    </div>
  </div>
</footer>
