---
/**
 * The Case Study hero, and the disclosure that must precede everything.
 *
 * `leadDisclosure` is rendered here, above the fold, outside any collapsible.
 * That placement is a spec requirement, not a layout preference: spec §7 puts
 * DFE's Rule DFE-0 ("この作品は OCR を実行していない") immediately after the
 * opening section and forbids folding it away, because the whole page reads
 * differently once you know the pipeline never touches a scanner. A correction
 * that arrives after the reader has formed the wrong belief has already failed.
 *
 * THE READOUT ROW IS GONE (#8 §7). It sat directly under the overview and
 * carried three chips: a test summary, the work's `caseVariant`, and the
 * repository path. Together they were the first thing a reader met on a Case
 * Study, and what they said was "this record has been verified" rather than
 * anything about the system.
 *
 *   caseVariant   `walkthrough` / `ledger` / `pipeline` name the renderer that
 *                 draws the spine below. That is a selector this repository
 *                 uses to lay out a page, in the same class as the entry
 *                 variants spec §11.1 removed from the public surface — and it
 *                 was printed to the reader as though it described the work.
 *   tests         still on the page, in 品質の担保方法, which is the section
 *                 that says how quality is held. A test count is an answer to
 *                 that question, not a badge to open with.
 *   repoPath      still on the page, as the linked repository in 証拠へのリンク.
 *                 A bare `ai-crm-demo/` is a path; the link is the thing a
 *                 reader can actually use.
 *
 * None of the three was deleted from the data, and the two that say something
 * to a reader both still render — lower down, next to the question they answer.
 */
import type { CaseStudy, Work } from '../../lib/content/schema.ts';
import Rail from '../layout/Rail.astro';
import { ui } from '../../lib/content/ui.ts';

interface Props {
  work: Work;
  caseStudy: CaseStudy;
}

const { work, caseStudy } = Astro.props;
---

<section class="hero">
  <div class="page">
    <div class="tr">
      <Rail index="00" labels={[...ui.caseStudy.railLabels, work.title]} />
      <div class="msr">
        <p class="mo ty">{work.productType}</p>
        {/*
          THE h1 IS THE WORK, NOT THE QUESTION (#11 §4).

          It used to be 「このシステムは何をするか」 — CS-1's section name — which
          made the largest text on the page a string the three published Case
          Studies had in common, and left the work's own name to an 11px rail
          label. A reader arriving from a search result, or one step down from
          the Technical page whose h1 IS the work's name, met a page that
          identified itself less specifically than its own child did.

          The question is not deleted; it is demoted to the h2 it always was.
          It names the section the lede below answers, which is the job it was
          doing all along — it was only ever the h1 because the hero had no
          other heading in it.
        */}
        <h1 class="dsp-s">{work.title}</h1>
        <h2 class="ovh">{ui.caseStudy.sections.overview}</h2>
        <p class="lede">{caseStudy.overview}</p>
        {caseStudy.leadDisclosure && (
          <p class="notclaim" style="margin-top:26px">{caseStudy.leadDisclosure}</p>
        )}
      </div>
    </div>
  </div>
</section>
