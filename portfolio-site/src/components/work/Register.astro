---
/**
 * The ruled register — one row per work. Used by 02 MORE PROJECTS and by the
 * /work/ archive.
 *
 * WHAT A ROW SAYS, AND WHAT IT STOPPED SAYING (#7, spec §6.6 / §19). The row
 * used to carry the problem, the implementation scope, an Evidence `proves`
 * line, a test count, `source.access` and the entry variant. Four of those are
 * internal: `v-stage` names a renderer, `public-repo` names a field value, and
 * neither is something a reader of a portfolio is being told. The other two
 * are Case Study material that made every row four times the height the spec
 * allows a MORE PROJECTS row to be.
 *
 * What is left is what the spec asks a row to answer: what it is called, what
 * kind of thing it is, what it does in one line, what it is built with, and
 * where to read more IF there is a page to read.
 *
 * NONE OF IT IS DELETED. Every field named above is still on the work record
 * and still under every gate; the Case Study renders them. "Not displayed" and
 * "not verified" are different states, and this component only changes the
 * first.
 *
 * LINKS. A row links only when `/work/<slug>/` is actually emitted — see
 * `workHasDetailPage`. Works added by #7 ship without Evidence, so their pages
 * do not exist yet and their rows are not links. A non-linking row is a
 * complete row, not a broken one: it carries no "準備中", no disabled-looking
 * affordance and no arrow, because a portfolio that advertises its own gaps is
 * describing its backlog instead of its work.
 */
import {
  pad2,
  workHasDetailPage,
  workHref,
  workSelectedTech,
  workShowsCaseStudyCta,
} from '../../lib/content/derive.ts';
import type { Evidence, Work } from '../../lib/content/schema.ts';
import { site } from '../../lib/content/site.ts';
import { fill, ui } from '../../lib/content/ui.ts';

interface Props {
  works: readonly Work[];
  /** Only to decide whether a work's detail page exists. */
  evidence?: readonly Evidence[];
  minSlots?: number;
  /** Where row numbering starts, so MORE PROJECTS can number from 01. */
  startIndex?: number;
  /** The archive shows role; compact homepage rows deliberately do not. */
  showRole?: boolean;
}

const {
  works,
  evidence = [],
  minSlots = site.registerMinSlots,
  startIndex = 1,
  showRole = false,
} = Astro.props;

const slots: number[] = [];
for (let n = works.length + 1; n <= minSlots; n += 1) slots.push(n);

/**
 * Two decisions, not one.
 *
 *   linked          is /work/<slug>/ actually emitted? Then the row is an
 *                   anchor. Restates the route's own getStaticPaths.
 *   showsCaseStudy  may we print the words "Case Study"? Only when one is
 *                   published — `EntryCta`'s condition, and the only one.
 *
 * A work can be the first without being the second: the entry screen renders
 * from the moment its Evidence resolves, and calling that link "Case Study を
 * 読む" would promise a body that is not there. Such a row now keeps only the
 * arrow affordance: the whole row is already the anchor and its title/purpose
 * provide the accessible name, while no false Case Study label is introduced.
 */
const rows = works.map((w, i) => ({
  work: w,
  index: pad2(i + startIndex),
  linked: workHasDetailPage(w, evidence),
  showsCaseStudy: workShowsCaseStudyCta(w),
}));
---

<div class="reg reg-c">
  {
    rows.map(({ work: w, index, linked, showsCaseStudy }) => {
      const body = (
        <>
          <span class="no"><span class="sq" />{index}</span>
          <span class="rc">
            <h3 aria-level="2">{w.title}</h3>
            <p class="cl">{w.purpose}</p>
            {showRole && w.role.length > 0 && (
              <span class="reg-role">
                <span class="mo">{ui.work.role}</span>
                <span>{w.role.join(' / ')}</span>
              </span>
            )}
            {/* Category and technologies share one line. Stacked, they made a
                four-line row where the tier's whole point is that it is short. */}
            <span class="meta">
              <span class="ty">{w.productType}</span>
              <span class="st">{workSelectedTech(w).join(' · ')}</span>
            </span>
          </span>
          <span class="rl">
            {linked && (
              <span class="lk">
                {showsCaseStudy && ui.work.caseStudyCta}
                <span class="ar" aria-hidden="true">→</span>
              </span>
            )}
          </span>
        </>
      );
      return linked ? (
        <a class="r" href={workHref(w.slug, false)} data-w={w.slug}>{body}</a>
      ) : (
        /* Not a link, and not pretending to be one. */
        <div class="r r-flat" data-w={w.slug}>{body}</div>
      );
    })
  }
  {
    slots.map((n) => (
      <div class="empty">
        {fill(ui.register.emptySlot, { index: pad2(n) })}
        {n === works.length + 1 && ui.register.emptySlotHint}
      </div>
    ))
  }
</div>
