---
/**
 * v-stage — inverted band, the figure takes the bleed.
 *
 * For a work whose screen is UI-dense and many-coloured: ink ground and a wide
 * mat let the screenshot be the subject instead of competing with the page.
 *
 * THE `v-stage` CLASS IS NEW HERE AND THE RULES FOR IT ARE NOT. components.css
 * and responsive.css have carried `.v-stage .in` and `.v-stage .fr-stage` since
 * the frozen prototype — five rules across three breakpoints — and nothing in
 * the rendered markup has ever matched them: the variant was a renderer name
 * and never a class. So the wide mat this variant is described by (56/72
 * against the shared 44) has not been drawn since V3, and the stage has been
 * taking the same mat as every other frame. Naming the variant on the section
 * makes the sheet that was written for it apply.
 */
import type { Evidence, Work } from '../../lib/content/schema.ts';
import { workFigure } from '../../lib/content/derive.ts';
import Rail from '../layout/Rail.astro';
import EntryCta from './EntryCta.astro';
import WorkBody from './WorkBody.astro';
import WorkFigure from './WorkFigure.astro';
import WorkHead from './WorkHead.astro';
import WorkMeta from './WorkMeta.astro';

interface Props {
  work: Work;
  evidence: Evidence;
  index: string;
  railLabels: readonly string[];
  eager?: boolean;
  /** See WorkEntry — the part this entry plays on the homepage, or null. */
  homepageRole?: string | null;
}

const { work, evidence, index, railLabels, eager = false, homepageRole = null } = Astro.props;

/**
 * THE LEAD IS SHOWN IN LAYERS, not as one plate (Phase 6).
 *
 * A single screenshot centred in a mat says "here is a picture of a screen".
 * The Lead has to say "there is a built thing here", and a built thing has more
 * than one surface. So the entry stacks three crops of the SAME artefact: one
 * behind, offset like the sheet under the top sheet; the subject plate; and one
 * in front, breaking the page's left margin.
 *
 * WHAT IS NOT DONE TO THEM, because this is Evidence and not stock art:
 *
 *   the file is the same public artefact the record attests — same bytes, same
 *   digest, one Evidence id. No second screenshot was produced for decoration.
 *   no filter, no opacity, no blend, no scale of the picture itself. The layers
 *   are CROPS and OCCLUSION, which is what the art direction is allowed to do
 *   around a figure (design-freeze §1.7).
 *   the two extra crops are `aria-hidden` with empty alt and are not
 *   focusable. They claim nothing: the caption, the ledger, the provenance and
 *   the zoom button all belong to the one subject figure, exactly as before.
 *
 * Only the homepage Lead takes this. A register of entries that all did it
 * would be a template again, which is the thing V4 keeps refusing.
 */
const layered = homepageRole === 'lead' && evidence.kind === 'screenshot';
const fig = workFigure(work);
---

<section class="s-band inv v-stage" id={`w-${work.slug}`} data-w={work.slug} data-homepage-role={homepageRole}>
  <div class="in">
    <div class="page">
      <div class="tr">
        <Rail index={index} labels={railLabels} />
        <div class="msr">
          <WorkHead work={work} />
          <WorkMeta work={work} />
          <EntryCta work={work} />
        </div>
      </div>
      {/*
        `data-mx-row` names the two rows for the motion prototype
        (feature/motion-experience-v2) and does nothing else: no class, no
        style, no structural change, and nothing in the frozen stylesheet
        selects on it. It exists so motion.css can address the figure and the
        body by what they are instead of by :nth-child, which would silently
        target the wrong row the day this variant gains one.
      */}
      <div class="tr" style="margin-top:52px" data-mx-row="figure">
        <div class="bleed">
          <div class:list={['page', layered && 'stg']}>
            {layered && (
              <span class="lay lay-b" aria-hidden="true">
                <img src={fig.src} width={fig.width} height={fig.height} alt="" loading={eager ? 'eager' : 'lazy'} />
              </span>
            )}
            <WorkFigure work={work} evidence={evidence} cropHeight={520} eager={eager} />
            {layered && (
              <span class="lay lay-f" aria-hidden="true">
                <img src={fig.src} width={fig.width} height={fig.height} alt="" loading={eager ? 'eager' : 'lazy'} />
              </span>
            )}
          </div>
        </div>
      </div>
      <div class="tr" style="margin-top:64px" data-mx-row="body">
        <div class="ins"></div>
        <div class="fld"><WorkBody work={work} /></div>
      </div>
    </div>
  </div>
</section>
