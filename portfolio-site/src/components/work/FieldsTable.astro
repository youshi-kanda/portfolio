---
/**
 * A work-owned data block, not a feature of any layout variant.
 *
 * Only a work that supplies `fieldsTable` gets one — the variant does not
 * conjure the data. For DFE this table is the literal `npm run demo` output,
 * which is why it can carry the composition: the picture is the work's own
 * result, not a diagram drawn to fill a column.
 */
import { fill, ui } from '../../lib/content/ui.ts';
import type { Work } from '../../lib/content/schema.ts';

interface Props {
  table: NonNullable<Work['fieldsTable']>;
}

const { table } = Astro.props;
---

<p class="mo" style="margin-bottom:14px"><b>{table.producedBy}</b> — {fill(ui.work.fieldsTableLabel, { count: table.rows.length })}</p>
<div class="fields">
  {
    table.rows.map((row) => (
      <div class={row.level === 'LOW' ? 'row hit' : 'row'}>
        <span class="k">{row.key}</span>
        <span class="v">{row.value}</span>
        <span class="c">{row.confidence}</span>
        <span class="s">{row.level}</span>
      </div>
    ))
  }
</div>
