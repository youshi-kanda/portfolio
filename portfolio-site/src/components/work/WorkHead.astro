---
/**
 * Product type, name, purpose — in that order.
 *
 * The purpose sits in the claim slot, not the key engineering decision. What
 * the thing IS and what was INTERESTING to build are separate fields rendered
 * in separate blocks, and an Engineering Highlight is never used as a product
 * description.
 */
import type { Work } from '../../lib/content/schema.ts';

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<p class="mo ty">{work.productType}</p>
<h3>{work.title}</h3>
<p class="claim">{work.purpose}</p>
