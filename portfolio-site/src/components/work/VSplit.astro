---
/**
 * v-split — 5/7 asymmetry, the plate escaping the right margin.
 *
 * For a work whose source of truth is a ruled document: the rules come onto the
 * page and the screen is placed as a board running off the measure.
 */
import type { Evidence, Work } from '../../lib/content/schema.ts';
import Rail from '../layout/Rail.astro';
import EntryCta from './EntryCta.astro';
import WorkBody from './WorkBody.astro';
import WorkFigure from './WorkFigure.astro';
import WorkHead from './WorkHead.astro';
import WorkMeta from './WorkMeta.astro';

interface Props {
  work: Work;
  evidence: Evidence;
  index: string;
  railLabels: readonly string[];
  eager?: boolean;
}

const { work, evidence, index, railLabels, eager = false } = Astro.props;
---

<section class="s-open" id={`w-${work.slug}`} data-w={work.slug}>
  <div class="page">
    <div class="tr">
      <Rail index={index} labels={railLabels} />
      <div class="fld">
        <div class="v-split">
          <div>
            <WorkHead work={work} />
            <WorkMeta work={work} />
            <EntryCta work={work} />
          </div>
          <div class="esc">
            <WorkFigure work={work} evidence={evidence} cropHeight={430} eager={eager} />
          </div>
        </div>
      </div>
    </div>
    <div class="tr" style="margin-top:56px">
      <div class="ins"></div>
      <div class="fld"><WorkBody work={work} /></div>
    </div>
  </div>
</section>
