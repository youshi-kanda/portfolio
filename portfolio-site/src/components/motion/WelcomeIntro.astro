---
/**
 * Homepage-only welcome layer.
 *
 * It is decorative, appears once per browser session, never locks scroll, and
 * never hides the page when JavaScript is unavailable or reduced motion is
 * requested. The element is `hidden` in source; only the early inline gate
 * enables it.
 */
import '../../styles/welcome.css';
---

<script is:inline>
  (() => {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('portfolio-welcome-v1') === '1') return;
      sessionStorage.setItem('portfolio-welcome-v1', '1');
      document.documentElement.classList.add('wi-ready');
    } catch {
      // Storage or scripting restrictions fall back to the normal page.
    }
  })();
</script>

<div class="welcome-intro" hidden aria-hidden="true">
  <div class="wi-rail">
    <span class="wi-index">00</span>
    <span class="wi-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <path d="M6 7.5 12.5 14v10.5M19 7.5 12.5 14" fill="none" stroke="#14654A" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"></path>
        <path d="M20 7.5v17M20 16l6-8.5M20 16l6 8.5" fill="none" stroke="#15171A" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"></path>
      </svg>
    </span>
  </div>
  <div class="wi-field">
    <span class="wi-kicker">ENGINEERING PORTFOLIO</span>
    <strong class="wi-name">YOUSHI-KANDA</strong>
    <span class="wi-rule"></span>
  </div>
</div>
