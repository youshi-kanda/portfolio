---
/**
 * A static sticky bar. Position is reported by a mono index and a 2px
 * hairline — an instrument, not a menu. No colour ramp, no label that grows.
 *
 * TWO LISTS, TWO JOBS. The masthead used to draw one list everywhere:
 * `site.sections`, the homepage's own running order, with the anchors rewritten
 * to `/#work` when it was drawn off the homepage. That is a table of contents
 * for a document the reader is not reading — and it has no entry for `/work/`,
 * because the archive is a page and not a band, which is how the archive ended
 * up with exactly one inbound link on the whole site.
 *
 *   homepage   the section index. Unchanged, scroll-spy included.
 *   elsewhere  the site's routes: WORK INDEX / HOW I BUILD / CONTACT.
 *
 * The item list stays derived. On the homepage a section that is not on this
 * page (05 FEATURED EVIDENCE at zero works) does not get a link, because an
 * anchor that resolves to nothing is a defect rather than a placeholder.
 *
 * `aria-current="page"` NOW MEANS THE PAGE. It was previously emitted on
 * `/work/`, `/work/<slug>/` and `/work/<slug>/technical/` alike, on a link
 * whose href was `/#work` — three kinds of page each claiming to be a fourth.
 * A page that merely lives UNDER an entry gets `data-section`, which draws the
 * same underline and tells the accessibility tree nothing that is not true.
 *
 * THE `Index` BOX IS A BUTTON. It was a bordered `<span>Index</span>` with no
 * handler and no tab stop — the one element in the chrome below 768px that
 * looked like a way out and was not one. Two changes answered that separately:
 * this branch gave it a real disclosure (the `<button>` and `.mob-panel`
 * below), and the wayfinding work removed the dead span in favour of the
 * breadcrumb. Both answers ship. The span is gone either way; what stands in
 * its place is a control that works, and the breadcrumb under this bar is the
 * trail — a disclosure that lists where you can GO, a breadcrumb that says
 * where you ARE. Neither is the other's fallback.
 *
 * ONE LIST, TWO RENDERINGS. `indexItems` is what the `<ol>` above draws and
 * what the panel draws, so the bar and the panel can never disagree about
 * which entries exist or where they point — on the homepage the section index,
 * elsewhere the same three routes. The panel's links carry no `aria-current`
 * and no `data-section`: those are claims about the current page, one per
 * page, and the `<ol>` above has already made them.
 */
import { brandHref, navItems, siteNavItems } from '../../lib/content/derive.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';

interface Props {
  /** Homepage only: the section label to mark. */
  current?: string | null;
  progress?: number;
  hasWorks?: boolean;
  /** Off the homepage, the masthead draws the site's routes instead. */
  onHomepage?: boolean;
}

const { current = null, progress = 0, hasWorks = true, onHomepage = true } = Astro.props;

const sections = onHomepage ? navItems(hasWorks, true) : [];
/*
 * NO PAGE TELLS THIS COMPONENT WHICH ENTRY IT IS.
 *
 * The marking is read off `Astro.url.pathname`, because a `section` prop would
 * be passed the same value by `/work/` and by `/work/<slug>/` — quite
 * reasonably, since both do live under the archive — which would put
 * `aria-current="page"` back on a link to `/work/` from `/work/crm/`. A page
 * that can state its own identity is a page that can state it wrongly.
 */
const routes = onHomepage ? [] : siteNavItems(Astro.url.pathname);

/*
 * What the mobile panel lists. Exactly one of the two above is non-empty, so
 * this is a selection and not a merge: the panel is the same index the bar
 * draws, revealed at a breakpoint where the bar's own `<ol>` is display:none.
 */
const indexItems = onHomepage ? sections : routes;
---

<nav class="nav" data-nav data-home-nav={onHomepage ? '' : undefined}>
  <div class="page">
    <a class="nm" href={brandHref(onHomepage)}>{site.handle}<i>{site.kicker}</i></a>
    <ol>
      {
        sections.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-target={onHomepage && item.href.startsWith('#') ? item.href.slice(1) : undefined}
              aria-current={item.label === current ? 'page' : undefined}
            >
              <i>{item.index}</i>{item.label}
            </a>
          </li>
        ))
      }
      {
        routes.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.isCurrentPage ? 'page' : undefined}
              data-section={item.isSection ? '' : undefined}
            >
              <i>{item.index}</i>{item.label}
            </a>
          </li>
        ))
      }
    </ol><button
      type="button"
      class="mob"
      aria-expanded="false"
      aria-controls="nav-index"
      data-nav-toggle
    >{ui.nav.mobileIndex}</button>
  </div>
  <div class="prg" style={`--p:${progress}%`}></div>
  {/*
    The mobile section index, and the reason it is a sibling of `.page` rather
    than a child of it: `.nav .page` is the flex row, so a panel inside it would
    become a third flex item and push the masthead. Outside it, `.nav` — which
    is `position:sticky`, and therefore a containing block — positions the panel
    under the bar with `top:calc(100% + 1px)` (polish.css).

    `indexItems` is the same array the desktop `<ol>` above renders, so the two
    lists cannot disagree about which entries exist or where they point. The
    links deliberately carry NO `data-nav-target`: the scroll spy below maps one
    link to one section, and a second link per section would leave one of them
    permanently without `aria-current`.
  */}
  <div class="mob-panel" id="nav-index" hidden data-nav-panel>
    <ol>
      {
        indexItems.map((item) => (
          <li>
            <a href={item.href}><i>{item.index}</i>{item.label}</a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

{/*
  The mobile index is a disclosure, not a dialog: the panel sits in the header,
  the page behind it stays usable, and nothing below it is inert. So there is no
  focus trap, no scroll lock and no `role="dialog"` — a `<button>` that owns an
  `aria-expanded` and a panel it names with `aria-controls` is the whole widget.

  Focus is not moved on open. Tab order already runs button → first link, and
  stealing focus would make the keyboard path disagree with the reading order.
  It is moved back on Escape only, where the panel closes under the user rather
  than at their request to leave it.

  `<button>` also does a second job. Chrome for iOS never extracts text inside
  BUTTON for its address/one-tap detection (ios/web/annotations `IGNORE_NODE_NAMES`),
  so the label stops being a candidate for the Mini Map it was being turned into.
  The `format-detection` meta in BaseLayout covers the rest of the page; this
  covers this label structurally, without depending on that meta being honoured.
*/}
<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = nav?.querySelector<HTMLElement>('[data-nav-panel]');

  if (nav && toggle && panel) {
    const narrow = window.matchMedia('(max-width: 767px)');
    const isOpen = () => !panel.hidden;

    const close = (returnFocus = false) => {
      if (!isOpen()) return;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (returnFocus) toggle.focus();
    };

    const open = () => {
      if (isOpen()) return;
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    };

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else open();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });

    // `pointerdown` runs before the button's own `click`, so a press ON the
    // button is filtered out here by the `contains` check and toggled there —
    // one gesture, one state change.
    document.addEventListener('pointerdown', (event) => {
      if (!isOpen()) return;
      const target = event.target;
      if (target instanceof Node && nav.contains(target)) return;
      close();
    });

    // Every entry is an anchor, and an in-page anchor scrolls to a section the
    // open panel would be covering.
    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) close();
    });

    // Leaving the mobile breakpoint with the panel open would carry it into a
    // layout that has no button to close it with.
    narrow.addEventListener('change', (event) => {
      if (!event.matches) close();
    });
  }
</script>

{
  onHomepage && (
    <script>
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-nav] [data-nav-target]')];
      const pairs = links
        .map((link) => {
          const id = link.dataset.navTarget;
          const section = id ? document.getElementById(id) : null;
          return section ? { link, section } : null;
        })
        .filter((pair): pair is { link: HTMLAnchorElement; section: HTMLElement } => pair !== null);

      if (pairs.length > 0) {
        const setCurrent = (active: HTMLAnchorElement | null) => {
          for (const { link } of pairs) {
            if (link === active) link.setAttribute('aria-current', 'location');
            else if (link.getAttribute('aria-current') === 'location') link.removeAttribute('aria-current');
          }
        };

        const visible = new Map<HTMLElement, number>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.set(entry.target as HTMLElement, entry.intersectionRatio);
              else visible.delete(entry.target as HTMLElement);
            }

            const current = [...pairs]
              .filter(({ section }) => visible.has(section))
              .sort((a, b) => (visible.get(b.section) ?? 0) - (visible.get(a.section) ?? 0))[0];
            setCurrent(current?.link ?? null);
          },
          { rootMargin: '-18% 0px -62% 0px', threshold: [0, 0.01, 0.25, 0.5, 0.75, 1] },
        );

        for (const { section } of pairs) observer.observe(section);
      }
    </script>
  )
}
