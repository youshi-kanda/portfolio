---
/**
 * #46 — the chapter mark. One per top-level homepage section.
 *
 * WHAT THIS IS FOR. The page numbers its sections and rules them off, and that
 * is the whole of the boundary: scrolling from 03 into 04 looks the same as
 * scrolling within 03, because every section is the same paper with the same
 * two tracks on it. The alternative usually reached for — tinting every other
 * section — would replace the ground the whole design is built on, so this is
 * the other way round: the ground is held and each section gets ONE quiet
 * graphic of its own, pinned inside its own bounds. What changes at a boundary
 * is the drawing, not the paper.
 *
 * WHAT IT IS NOT. It carries nothing. The motif is `aria-hidden` and its
 * container takes no pointer events; deleting this component and its
 * stylesheet returns the homepage to what it was, with no sentence, link or
 * control lost. Nothing here may be the only place something is said — the
 * section's own heading, rail and number already say all of it.
 *
 * HOW IT SITS. The wrapper is `position:absolute; inset:0` over the section
 * and paints at `z-index:-1`, which is the same seat `motion.css` §A gives the
 * background folio — every `[data-mx-n]` section is already `position:relative`
 * with `isolation:isolate`, so the negative layer is trapped inside the section
 * and cannot escape to the root. The inner box is `position:sticky`, so the
 * motif pins while its section passes and is released by the section's own
 * bottom edge. No `position:fixed` anywhere: nothing here outlives the section
 * it belongs to. See section-motif.css for the whole of the geometry.
 *
 * THE DRAWING. Line, outline, grid, node, square — the same vocabulary the
 * page already draws in, at 1px, in the ink and the signal colour it already
 * has. `vector-effect:non-scaling-stroke` (set once in section-motif.css) is
 * what keeps the strokes hairlines at every rendered size, so the motif is the
 * site's own 1px rule and not a scaled-up illustration of one. The geometry is
 * written against a 240×240 box and nothing else is authored per section — the
 * position, the size, the weight and the pin are all the stylesheet's, so the
 * five drawings cannot drift apart. No image is fetched, no filter is applied and
 * no colour is introduced: `currentColor` reads the alpha the stylesheet sets
 * from `--tx`, so the ink follows the theme (and inverts by itself inside
 * `.inv`, which is how 05 CONTACT is drawn on ink rather than on paper).
 */

/** The five top-level sections. 00 HERO is deliberately not one — it has its
 *  own back plane already (components.css, `.hf`), and a second graphic there
 *  would be a third plane doing the second one's job. */
type Motif = 'work' | 'more' | 'capabilities' | 'about' | 'contact';

interface Props {
  motif: Motif;
}

const { motif } = Astro.props;
---

<div class="smo" data-smo={motif} aria-hidden="true">
  <div class="page smo-page">
    <div class="smo-fig">
      <svg
        class="smo-svg"
        viewBox="0 0 240 240"
        width="240"
        height="240"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        focusable="false"
      >
        {
          /* 01 FEATURED WORK — implemented structure. Three sheets of the
             same size, offset by one constant step, the front one ruled into
             columns. The two behind it are DRAWN OCCLUDED — each is the L of
             its outline that the sheet in front does not cover — which is the
             same rule the Lead's own crops follow (components.css, `.lay-b`:
             only the strip beyond the mat is ever seen). Trimmed, the stack
             reads as depth; untrimmed, it is six rectangles crossing each
             other. Not a card either: no radius, no fill, no shadow, and the
             only thing drawn inside is the column grid the page is set on. */
          motif === 'work' && (
            <g>
              <path d="M6 14H156V60M6 14V118H44" />
              <path d="M44 60H194V106M44 60V164H82" />
              <rect x="82" y="106" width="150" height="104" />
              <path d="M112 106V210M142 106V210M172 106V210M202 106V210" />
              <rect class="smo-sig" x="82" y="106" width="9" height="9" />
            </g>
          )
        }
        {
          /* 02 MORE — derivation. One spine and the branches taken off it, two
             of which branch again. Orthogonal, because every line this design
             draws is: a diagonal here would be the one stroke on the page that
             belongs to no grid. */
          motif === 'more' && (
            <g>
              <path d="M36 20V196" />
              <path d="M36 58H150" />
              <path d="M36 104H92V146H200" />
              <path d="M36 176H128" />
              <rect x="147" y="55" width="7" height="7" />
              <rect x="197" y="143" width="7" height="7" />
              <rect x="125" y="173" width="7" height="7" />
              <rect class="smo-sig" x="32" y="16" width="9" height="9" />
            </g>
          )
        }
        {
          /* 03 CAPABILITIES — four modules on one bus. The ring is what they
             have in common and the cross is where it meets; the node at the
             crossing is the rail's own 9px square, which is the mark this
             design already uses for "here". */
          motif === 'capabilities' && (
            <g>
              <rect x="24" y="24" width="56" height="56" />
              <rect x="160" y="24" width="56" height="56" />
              <rect x="24" y="160" width="56" height="56" />
              <rect x="160" y="160" width="56" height="56" />
              <path d="M24 44H80M160 44H216M24 180H80M160 180H216" />
              <path d="M80 52H160M80 188H160M52 80V160M188 80V160" />
              <path d="M120 52V188M52 120H188" />
              <rect class="smo-sig" x="116" y="116" width="9" height="9" />
            </g>
          )
        }
        {
          /* 04 ABOUT — a record, not a person. The sheet, its head rule, and
             the rows of label-then-statement the section is actually built out
             of (`.spx .r`) — the rules are cut to different lengths, because
             a column of equal ones is a table and this is prose. No
             silhouette, no portrait, no avatar. */
          motif === 'about' && (
            <g>
              <rect x="44" y="10" width="152" height="220" />
              <path class="smo-rule" d="M60 44H180" />
              <path d="M90 78H180M90 106H166M90 134H180M90 162H154M90 190H172" />
              <rect class="smo-fill" x="60" y="75" width="22" height="5" />
              <rect class="smo-fill" x="60" y="103" width="22" height="5" />
              <rect class="smo-fill" x="60" y="131" width="22" height="5" />
              <rect class="smo-fill" x="60" y="159" width="22" height="5" />
              <rect class="smo-sig" x="60" y="187" width="22" height="5" />
            </g>
          )
        }
        {
          /* 05 CONTACT — one line between two ends, with a single turn in it
             so it reads as a route and not as a rule the page already draws
             everywhere. The last section carries the least of the five:
             everything below it is the footer, and a busy watermark there is
             noise at the exact moment the page is asking for a reply. */
          motif === 'contact' && (
            <g>
              <path d="M14 134H118V106H226" />
              <rect x="8" y="128" width="12" height="12" />
              <rect class="smo-sig" x="217" y="101.5" width="9" height="9" />
            </g>
          )
        }
      </svg>
    </div>
  </div>
</div>
