---
/**
 * 01 FEATURED WORK — five works, each introduced exactly once.
 *
 * THE SHAPE. One block per work: index and category on the rail, the title,
 * one or two sentences, a large figure, then Role and Selected technology, in
 * that order. The order is the spec's (§1.2) and it is the argument the page is
 * making — Problem, what was built, who built it, and only then what it was
 * built with. A gallery that led with the stack would be proving a different
 * claim than the one this portfolio is for.
 *
 * WHAT IS NOT HERE. API counts, migration counts, test counts, CI detail,
 * architecture prose, limitations, provenance. All of it is still on the work
 * record and still gated; the Case Study renders it. A homepage block that
 * carried it measured 3,392px for one work, which is four screens to introduce
 * one thing.
 *
 * READING ORDER. Title, figure, then the sentence — the same order at every
 * width, and the order the spec fixes for mobile (§12.2). Putting the prose
 * above the figure read reasonably on a wide screen and cost 115px before the
 * first picture, which is what kept 01 below the fold; more to the point, it
 * meant desktop and mobile were two different arguments about what a reader
 * should meet first.
 *
 * THE HIERARCHY — #30 HD-G. broad / narrow was POSITION: alternating widths so
 * the eye got a beat instead of five identical stops, explicitly not a ranking.
 * It is now the ranking. The owner decided (Issue #30 comment 5746615341) that
 * two of the five are 代表作 and the other three show the range, and a page
 * whose only width signal contradicted that decision would be arguing with it.
 *
 * So `data-width` is derived from `featuredTier` and the alternation is gone:
 * primary keeps the full field and the large figure, supporting keeps the
 * measure and a shorter one. FIVE BLOCKS, ONE DESIGN. Supporting is the same
 * component with a tighter figure, title and rhythm — not a second card style —
 * and it loses no information: background, Role, Selected technology and the
 * evidence block are rendered identically on all five.
 *
 * NO VISIBLE TIER LABEL. Primary / supporting remains the layout hierarchy,
 * but neither tier prints a grade. The distinction is editorial weighting on
 * one page, not a judgement about the work.
 *
 * WHAT EACH BLOCK ANSWERS. #30 §2: what the work is for (purpose), how it came
 * about (開発背景, derived from #29's portfolioProfile), what this engineer did
 * (Role), what it is built with (Selected technology), and what a reader can go
 * and check for themselves (確認できるもの). The last one is the point of the
 * issue: a portfolio that shows work without saying what can be verified leaves
 * the reader to guess, and a portfolio that links nothing and explains nothing
 * reads as a portfolio with something to hide.
 *
 * CASE STUDY LINKS. Gated on `caseStudyPublished` and nothing else — the same
 * condition `EntryCta` uses. Not on whether /work/<slug>/ exists: that page is
 * emitted as soon as a work's Evidence resolves, Case Study or no, so linking
 * on it would put the label "Case Study を読む" in front of the entry screen.
 *
 * AND NOT ON THE SOURCE LINK EITHER. The two CTAs are independent conditions on
 * purpose: `crm` shows both, a work with a published Case Study and a withheld
 * source would show only the first, and folding the source into the Case Study
 * condition would silently retire a link whose own condition still holds.
 *
 * THE SOURCE LINK. Built by `workPublicSourceUrl`, which returns null for
 * anything `workSourceIsLinkable` refuses. This component never reads
 * `showcase.source.access`: a work whose repository is genuinely public and
 * whose link this portfolio withholds would be linked by a component that asked
 * `access` alone, and it would be RIGHT about the access while doing it.
 *
 * Four of these five have no source link, and their evidence block says so in
 * the owner's own approved sentence (HD-I) rather than ending in silence or in
 * a greyed-out affordance. The sentence states only what is certain in public —
 * that the link is not published — and distinguishes neither private
 * repositories nor withheld public ones, because distinguishing them would
 * publish the thing withholding is for.
 */
import {
  developmentBackground,
  pad2,
  workFeaturedTier,
  workFigure,
  workHref,
  workPublicSourceUrl,
  workSelectedTech,
  workShowsCaseStudyCta,
  sectionNumber,
} from '../../lib/content/derive.ts';
import type { Work } from '../../lib/content/schema.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';
import SectionMarker from './SectionMarker.astro';
import { copyText } from '../../lib/content/copy.ts';

interface Props {
  works: readonly Work[];
}

const { works } = Astro.props;
const index = sectionNumber('work');
const h2 = await copyText('home.works.h2');

/**
 * HD-I, read from the registry rather than written here. The sentence is the
 * owner's, approved at Issue #30 comment 5746615341, and a component holding a
 * copy of it would be a second place for an approved string to live — which is
 * exactly what `approvedCopyGate` cannot see and so cannot hold.
 */
const sourceWithheld = await copyText('home.works.sourceWithheld');

const blocks = works.map((work, i) => {
  const tier = workFeaturedTier(work);
  return {
    work,
    n: pad2(i + 1),
    tier,
    /** #30 — width IS the tier now. It was position; see the note above. */
    broad: tier === 'primary',
    showsCaseStudy: workShowsCaseStudyCta(work),
    /** null unless the source model says this site publishes a way in. */
    sourceUrl: workPublicSourceUrl(work),
    background: developmentBackground(work.portfolioProfile),
    figure: workFigure(work),
    eager: i === 0,
  };
});
---

<section class="s-open" id="work" data-mx-n={index}>
  {/* #46 — the chapter opening. The section's own number and name at
      folio size; decorative, `aria-hidden`, and bounded to the head of
      the section by section-marker.css. */}
  <SectionMarker section="work" />
  {/* Desktop-only visual rail. It spans the whole section so `sticky` can stay
      pinned while all five works pass on the right. The original Rails remain
      in the DOM and keep the mobile/accessibility reading order unchanged. */}
  <div class="fw-master-track" aria-hidden="true">
    <div class="page fw-master-page">
      <div class="ins fw-master-rail">
        <span class="ix">{index}</span>
        {site.selectedWork.railLabels.map((label) => <span class="lb">{label}</span>)}
        <span class="rn">{works.length} works</span>

        <span class="fw-master-current">
          {
            blocks.map(({ work: w, n }, i) => (
              <span
                class:list={['fw-master-item', { 'is-active': i === 0 }]}
                data-featured-current={w.slug}
                data-w={w.slug}
              >
                <span class="fw-master-index">
                  <i class="sq" />
                  {n}
                </span>
                <span class="lb">{w.productType}</span>
              </span>
            ))
          }
        </span>
      </div>
    </div>
  </div>

  <div class="page">
    <div class="tr">
      <Rail index={index} labels={site.selectedWork.railLabels} note={`${works.length} works`} />
      <div class="msr"><h2>{h2}</h2></div>
    </div>
  </div>

  {
    blocks.map(
      ({ work: w, n, tier, broad, showsCaseStudy, sourceUrl, background, figure, eager }) => (
      <article
        class="fw"
        data-w={w.slug}
        data-featured-block
        data-featured-tier={tier}
        data-width={broad ? 'broad' : 'narrow'}
      >
        <div class="page">
          <div class="tr">
            <Rail index={n} labels={[w.productType]} />
            <div class="msr">
              <h3 class="fw-t">{w.title}</h3>
            </div>
          </div>
          <div class="tr">
            <div class="ins" />
            <div class={broad ? 'fld' : 'msr'}>
              <figure class="fw-f">
                <span class="crop">
                  <img
                    src={figure.src}
                    width={figure.width}
                    height={figure.height}
                    alt={w.title}
                    loading={eager ? 'eager' : 'lazy'}
                  />
                </span>
                {/* Small, and next to the picture rather than over the page:
                    the statement belongs to the image, not to the portfolio. */}
                <figcaption>{figure.caption}</figcaption>
              </figure>
            </div>
          </div>
          <div class="tr">
            <div class="ins" />
            <div class="msr">
              <p class="fw-c">{w.purpose}</p>
              {/* One order, every width. 背景 → Role → 技術 is the reading the
                  spec fixes (#30 §5), and nothing below reorders it in CSS:
                  the tab order and the visual order are the DOM order. */}
              <div class="fw-m">
                <span class="fx">
                  <span class="mo">{ui.work.background}</span>
                  <p>{background}</p>
                </span>
                {w.role.length > 0 && (
                  <span class="fx">
                    <span class="mo">{ui.work.role}</span>
                    <p>{w.role.join(' / ')}</p>
                  </span>
                )}
                <span class="fx">
                  <span class="mo">{ui.work.selectedTech}</span>
                  <p>{workSelectedTech(w).join(' · ')}</p>
                </span>
              </div>
              {/* 確認できるもの — the block every Featured work ends on, with
                  either the routes to check it or the reason there are none.
                  It is never empty: an absent explanation is what makes a
                  missing link read as something withheld from the reader. */}
              <div class="fw-e">
                <span class="mo">{ui.work.evidenceHead}</span>
                {showsCaseStudy && (
                  <a class="lk fw-l" href={workHref(w.slug, false)}>
                    {ui.work.caseStudyCta}<span class="ar">→</span>
                  </a>
                )}
                {sourceUrl && (
                  <a class="lk fw-l" href={sourceUrl} data-featured-source-link={w.slug}>
                    {ui.work.sourceCta}<span class="ar">→</span>
                  </a>
                )}
                {sourceUrl === null && <p class="note fw-w m0">{sourceWithheld}</p>}
              </div>
            </div>
          </div>
        </div>
      </article>
      ),
    )
  }
</section>

<script>
  const featuredSection = document.querySelector<HTMLElement>('#work');
  const featuredBlocks = featuredSection
    ? [...featuredSection.querySelectorAll<HTMLElement>('[data-featured-block]')]
    : [];
  const featuredReadouts = featuredSection
    ? [...featuredSection.querySelectorAll<HTMLElement>('[data-featured-current]')]
    : [];

  if (featuredBlocks.length > 0 && featuredReadouts.length > 0) {
    const activate = (slug: string) => {
      for (const readout of featuredReadouts) {
        readout.classList.toggle('is-active', readout.dataset.featuredCurrent === slug);
      }
    };

    const currentWork = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              Math.abs(a.boundingClientRect.top - innerHeight * 0.48) -
              Math.abs(b.boundingClientRect.top - innerHeight * 0.48),
          );
        const target = visible[0]?.target as HTMLElement | undefined;
        if (target?.dataset.w) activate(target.dataset.w);
      },
      { rootMargin: '-44% 0px -48% 0px' },
    );

    for (const block of featuredBlocks) currentWork.observe(block);
  }
</script>
