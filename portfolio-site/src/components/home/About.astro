---
/**
 * 06 ABOUT — only what the repositories can confirm.
 *
 * Every row here carries the locator it came from, rendered next to it. There
 * is no second list. The prototype ended this section with a 未提供 block that
 * named 経歴 / 稼働条件 / 料金 and set each of them to 未記入; that block is gone
 * (IMPLEMENT-03 §5) and nothing replaced it.
 *
 * The reason is not that the gap is embarrassing. It is that a public page and
 * a prototype have different readers. In the prototype 未記入 was a note to the
 * people building it — a slot with a name and no value yet. To a visitor the
 * same three rows read as a statement the site is making about itself, and it
 * is a statement no source backs. Facts that arrive later get rows here with
 * `sourceRef` filled in, which is the only way anything gets one.
 *
 * PROFILE_INVENTED = NO. Removing the rows was the whole change; no sentence
 * was written to stand in for them.
 */
import { copyText } from '../../lib/content/copy.ts';
import { sectionNumber } from '../../lib/content/derive.ts';
import { site } from '../../lib/content/site.ts';
import Rail from '../layout/Rail.astro';

const a = site.about;
const index = sectionNumber('about');
const h2 = await copyText('home.about.h2');
---

{/* `data-mx-n` — see Hero.astro. The index is `site.about`'s own. */}
<section class="s-open" id="about" data-mx-n={index}>
  <div class="page">
    <div class="tr">
      <Rail index={index} labels={a.railLabels} />
      <div class="fld">
        <h2 style="max-width:720px">{h2}</h2>
        {/* #7 — how this engineer works, before the premises. ABOUT used to
            open with its own fine print, which told a reader who had just
            finished the work what the site was NOT claiming before telling
            them anything about the person. */}
        <div class="ab-now">
          {a.now.map((line) => <p>{line}</p>)}
        </div>
        <div class="spx wide" style="margin-top:30px">
          {
            a.known.map((k) => (
              <div class="r">
                <span class="k">{k.key}</span>
                {/* #7 — the locator is NOT rendered. `spec CS-8` is an
                    internal citation: it tells a maintainer where the sentence
                    came from and tells a visitor nothing they can act on.
                    `sourceRef` stays required on the record and stays under the
                    Truth Gate — the fact still has to have a source, the page
                    just stops printing its filing reference (spec §20). */}
                <span class="v">{k.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
