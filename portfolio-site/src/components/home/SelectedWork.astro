---
/**
 * 01 WORK — the heading, one Lead entry, then the index of everything.
 *
 * V3 put every shipping work on the homepage at full entry size, which reads as
 * three arguments in a row and asks the reader to finish all of them before
 * reaching anything else. V4 makes one argument in full and lists the rest:
 * the Lead entry is a work shown the way a work should be shown, and the index
 * under it answers the same questions for every work in one row each.
 *
 * DOM ORDER IS LOad-BEARING, for now. The art-direction layer pins the first
 * entry's figure and slides a text plate over it, and it selects that entry as
 * `#work + section` — the section immediately after this heading. So the Lead
 * goes directly after the heading and the index comes after the Lead. Phase 7
 * repoints those rules at `[data-homepage-role="lead"]` and the adjacency stops
 * mattering; until then, moving the Lead is a motion change whether or not
 * anyone intends it to be.
 *
 * Data-driven end to end: this reads the work collection and nothing else, so
 * adding, removing, archiving or reordering a work is an edit to
 * `src/content/work/` and never a component change. It renders correctly at 0,
 * 1, 3 and 20 works, and at 0 or 1 Lead.
 *
 * The heading carries no count. A literal "3" in the copy is a defect that
 * only surfaces the day a fourth work lands — the count belongs on the rail,
 * where it is derived.
 */
import { copyText } from '../../lib/content/copy.ts';
import { leadWork, sectionNumber } from '../../lib/content/derive.ts';
import type { Evidence, Work } from '../../lib/content/schema.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';
import Register from '../work/Register.astro';
import WorkEntry from '../work/WorkEntry.astro';

interface Props {
  works: readonly Work[];
  evidence: readonly Evidence[];
}

const { works, evidence } = Astro.props;
const section = site.selectedWork;
const index = sectionNumber('work');
const byId = new Map(evidence.map((e) => [e.id, e]));

const h2 = await copyText('home.works.h2');
const lede = await copyText('home.works.lede');

/**
 * The Lead, paired with the Evidence its entry draws. A Lead whose Evidence
 * record is missing is not drawn as a broken entry — it falls back to being one
 * row of the index like every other work, which is a complete statement.
 */
const lead = leadWork(works);
const leadEvidence = lead ? byId.get(lead.evidence[0] ?? '') : undefined;
---

{
  works.length === 0 ? (
    <section class="s-open" id="work" data-mx-n={index}>
      <div class="page">
        <div class="tr">
          <Rail index={index} labels={section.railLabels} />
          <div class="fld">
            <div class="reg"><div class="empty">{ui.empty.selectedWork}</div></div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <>
      {/* `data-mx-n` — see Hero.astro. The index is this section's place in
          the running order, derived rather than written down. */}
      <section class="s-open" id="work" data-mx-n={index}>
        <div class="page">
          <div class="tr">
            <Rail
              index={index}
              labels={section.railLabels}
              note={`${works.length} works`}
            />
            <div class="msr">
              <h2>{h2}</h2>
              <p class="lede m0">{lede}</p>
            </div>
          </div>
        </div>
      </section>
      {lead && leadEvidence && (
        <WorkEntry
          work={lead}
          evidence={leadEvidence}
          position={0}
          homepageRole="lead"
        />
      )}
      {/*
        THE INDEX TAKES THE PAGE, not the field (Phase 6). A register of large
        editorial rows needs the width its rows are composed at: inside the
        720/1040 field track a 620px visual leaves the prose 244px, which is
        how an index becomes a card grid. `.bleed` re-establishes the page's own
        margins one level down, exactly as the Lead's figure row does.
      */}
      <section class="s-tight" data-homepage-role="index">
        <div class="page">
          <div class="tr">
            <div class="bleed">
              <div class="page">
                <Register works={works} evidence={evidence} minSlots={0} />
              </div>
            </div>
          </div>
        </div>
      </section>
    </>
  )
}
