---
/**
 * 02 HOW I BUILD — the five steps, as the person commissioning the work sees
 * them.
 *
 * WHAT THIS SECTION STOPPED BEING. It was the AI development method in the
 * author's own words: an eight-step workflow whose every step named the tool
 * that ran it, a lane key and a roles table assigning duties to Human /
 * ChatGPT / Claude Code, an Intent list, and a block of things the page
 * explicitly declined to claim — rendered, by the note that used to stand
 * here, "as prominently as the workflow itself rather than tucked into a
 * footnote".
 *
 * That was the right call for what the page was then and the wrong page to
 * have. A reader deciding whether to commission work is asking what happens
 * after they do; which model executed step 04 does not change what they
 * receive, and a list of things not being claimed teaches them the claim
 * before denying it. The copy audit classified all of it as developer
 * philosophy and defensive copy, and the whole of it was approved for deletion.
 *
 * WHAT IS LEFT IS THE SAME WORK, DESCRIBED FROM THE OTHER SIDE. The eight
 * steps fold into five with nothing dropped: Requirement → 01, Specification
 * and Planning → 02, Coding and Independent Review → 03, Tests / CI → 04,
 * Evidence and Human Decision → 05. Review and verification are still in the
 * process; they are stated as something the client gets rather than as a lane
 * an AI occupies.
 */
import { site } from '../../lib/content/site.ts';
import { fill, ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';

interface Props {
  detail?: boolean;
  /**
   * #10 — whether this section states its own title.
   *
   * It was written as a homepage section, so it opens with its own rail,
   * `<h2>` and lede. /how-i-build/ then wrapped it in a page that opens with
   * the SAME two strings — `site.howIBuild.title` and `.lede` — as an `<h1>`
   * and a `.lede`, because a page needs an h1 of its own. Both rendered, so
   * the only page that uses this component printed its title twice, its lede
   * twice and two `M` rails, one under the other.
   *
   * The page passes `heading={false}` and supplies the rail labels to its own
   * `Rail` instead, so no approved string is dropped — the head is stated
   * once, at the level the document outline needs.
   */
  heading?: boolean;
}

const { detail = false, heading = true } = Astro.props;
const b = site.howIBuild;
/**
 * #7 — this is a page of its own now (/how-i-build/), not a section of the
 * homepage's running order. `sectionNumber('build')` would throw: `build` left
 * `site.sections` when the long form left the homepage, and deriving a number
 * from a list this no longer appears in would be asking the wrong question.
 * The rail carries the method's own mark instead of a homepage index.
 */
const index = 'M';
---

<section class="s-open" id="build" data-mx-n={index}>
  <div class="page">
    {heading && (
      <div class="tr">
        <Rail index={index} labels={b.railLabels} />
        <div class="msr">
          <h2>{b.title}</h2>
          <p class="claim">{b.lede}</p>
        </div>
      </div>
    )}

    <div class="tr" style="margin-top:44px">
      <div class="ins">
        <span class="lb">{ui.howIBuild.workflowLabel}</span>
        <span class="lb">{fill(ui.howIBuild.workflowCount, { count: b.workflow.length })}</span>
      </div>
      <div class="fld">
        {/*
          NO LANES. The workflow was drawn as three lanes, one per party, with
          a key naming them Human / ChatGPT / Claude Code. The lanes were the
          diagram's own axis — and its axis was which tool does what, which is
          the thing this page stopped being about. A step is now what happens
          and what the client gets out of it, in one column.

          `.flow` carries its own rule again: `.lanes + .flow` used to zero it
          because the key above it was the head (components.css).
        */}
        <div class="flow">
          {
            b.workflow.map((s) => (
              <div class="fst">
                <span class="k">{s.index}</span>
                <span class="n">{s.name}</span>
                <span class="d">{s.what}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {
      detail && (
        <div class="tr" style="margin-top:56px">
          <div class="ins"><span class="lb">{ui.howIBuild.sourceLabel}</span></div>
          <div class="msr">
            {b.sourceRefs.map((s) => <p class="note">{s}</p>)}
          </div>
        </div>
      )
    }
  </div>
</section>
