---
/**
 * 02 HOW I BUILD — the AI development method, in the author's own words.
 *
 * Every string in this section is the brief's own wording; nothing here is
 * inferred about how the work is actually done. That includes 開発の前提 —
 * who holds which part of the work, and what the published content is not
 * built on — rendered as prominently as the workflow itself rather than
 * tucked into a footnote.
 *
 * #31 — that block used to be 「主張しないこと」, two sentences each written as
 * a refusal. The owner replaced the framing (Issue #31 comment 5747908981):
 * it now states how the work is actually done and then bounds what the
 * published content covers. The boundary itself is unchanged — the second
 * sentence still puts 完全自動の Multi-Agent 開発 and a built harness outside
 * what this site is claiming.
 *
 * The two sentences are APPROVED copy and are read from the registry by id.
 * `site.howIBuild.premises` holds the ids and their order, which is what the
 * section content legitimately owns; the sentences live where their approval
 * record lives, and `copyText` throws on an id the registry does not have.
 */
import { copyText } from '../../lib/content/copy.ts';
import { site } from '../../lib/content/site.ts';
import { fill, ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';
import SectionHead from '../layout/SectionHead.astro';

interface Props {
  detail?: boolean;
  /**
   * #10 — whether this section states its own title.
   *
   * It was written as a homepage section, so it opens with its own rail,
   * `<h2>` and lede. /how-i-build/ then wrapped it in a page that opens with
   * the SAME two strings — `site.howIBuild.title` and `.lede` — as an `<h1>`
   * and a `.lede`, because a page needs an h1 of its own. Both rendered, so
   * the only page that uses this component printed its title twice, its lede
   * twice and two `M` rails, one under the other.
   *
   * The page passes `heading={false}` and supplies the rail labels to its own
   * `Rail` instead, so no approved string is dropped — the head is stated
   * once, at the level the document outline needs.
   */
  heading?: boolean;
}

const { detail = false, heading = true } = Astro.props;
const b = site.howIBuild;
/**
 * #7 — this is a page of its own now (/how-i-build/), not a section of the
 * homepage's running order. `sectionNumber('build')` would throw: `build` left
 * `site.sections` when the long form left the homepage, and deriving a number
 * from a list this no longer appears in would be asking the wrong question.
 * The rail carries the method's own mark instead of a homepage index.
 */
const index = 'M';

/** 開発の前提 — the approved sentences, in the order site.json states them. */
const premises = await Promise.all(site.howIBuild.premises.map((id) => copyText(id)));
---

<section class="s-open" id="build" data-mx-n={index}>
  <div class="page">
    {heading && (
      <div class="tr">
        <Rail index={index} labels={b.railLabels} />
        <div class="msr">
          <h2>{b.title}</h2>
          <p class="claim">{b.lede}</p>
        </div>
      </div>
    )}

    <div class="tr" style="margin-top:44px">
      <div class="ins">
        <span class="lb">{ui.howIBuild.workflowLabel}</span>
        <span class="lb">{fill(ui.howIBuild.workflowCount, { count: b.workflow.length })}</span>
      </div>
      <div class="fld">
        {/*
          THE LANES GET HEADS (Phase 6). The workflow is drawn as three lanes —
          one per party — and until now nothing said which lane was whose
          except the owner printed inside each step. A reader had to infer the
          diagram's own axis from its contents.

          The heads are the roles the section already declares, in the order
          the lanes are assigned (`human / chatgpt / claude`, motion.css §B).
          No string is authored here and none is removed: the duty of each role
          is still stated by the roles table below, which is where a reader who
          wants it goes. Below 1024 the lanes become one spine and these become
          its key, above the first stop.
        */}
        <div class="lanes" aria-hidden="true">
          {b.roles.map((r) => <span>{r.role}</span>)}
        </div>
        <div class="flow">
          {
            b.workflow.map((s) => (
              <div class={s.tag ? 'fst gate' : 'fst'}>
                <span class="k">{s.index}</span>
                <span class="n">{s.name}</span>
                <span class="o" data-r={(s.owner.split(' ')[0] ?? '').toLowerCase()}>
                  {s.owner}
                </span>
                <span class="d">{s.what}</span>
                {s.tag && <span class="g">{s.tag}</span>}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="tr" style="margin-top:56px">
      <div class="ins"><span class="lb">{ui.howIBuild.rolesLabel}</span></div>
      <div class="fld">
        <SectionHead label={ui.howIBuild.rolesHead} sub={ui.howIBuild.rolesSub} />
        <div class="tw">
          <table>
            <tbody>
              {b.roles.map((r) => <tr><th>{r.role}</th><td>{r.duty}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="tr" style="margin-top:56px">
      <div class="ins"><span class="lb">{ui.howIBuild.intentLabel}</span></div>
      <div class="msr">
        <ul class="dash">{b.intent.map((t) => <li>{t}</li>)}</ul>
        {/*
          #31 — A REAL `<h2>`, not an `<h4>` declaring `aria-level="2"`.

          The outline the owner specified is h1 HOW I BUILD → h2 開発の前提 →
          h2 判断事例, and this is the first of the two. It used to be an `<h4>`
          carrying `aria-level`, which the accessibility tree reads correctly
          but which leaves the document saying one thing and the markup another.

          The tag changed and nothing about the drawing did: `.premise h2` in
          components.css restates the mono 10.5px treatment, so `.ad h2`'s 40px
          display size never applies here. The element is a heading; it is not
          a display line, and it was never drawn as one.

          `aria-level` survives for the one case that still needs it — when
          this section states its own `<h2>` title above, a nested `<h2>` would
          be a sibling of the section rather than a part of it.
        */}
        <div class="premise">
          <h2 aria-level={heading ? 3 : undefined}>{ui.howIBuild.premises}</h2>
          <ul>{premises.map((t) => <li data-premise>{t}</li>)}</ul>
        </div>
      </div>
    </div>

    {
      detail && (
        <div class="tr" style="margin-top:56px">
          <div class="ins"><span class="lb">{ui.howIBuild.sourceLabel}</span></div>
          <div class="msr">
            {b.sourceRefs.map((s) => <p class="note">{s}</p>)}
          </div>
        </div>
      )
    }
  </div>
</section>
