---
/**
 * The Editorial Band — the featured works, edge to edge, hairline dividers.
 *
 * V3's Triptych, with two things changed and the rest carried over. It is a
 * register header, not a card grid: no box, no radius, no shadow, no island of
 * padding, and each panel names the product and the language, because a claim
 * on its own does not say what the thing is.
 *
 * It also carries SITE-01. Raising the display was only possible because this
 * strip puts part of the first project screenshot inside the reference viewport
 * without shrinking a single type size.
 *
 * WHAT CHANGED. Every panel links to `/work/<slug>/`, where V3 linked to
 * `#w-<slug>`. In V4 the homepage carries one work entry, so an in-page
 * fragment would resolve for the Lead and dangle for the other two — and the
 * fix is not to give the Lead a different link. Panels that look the same
 * behave the same: one navigation contract for the band, and the Lead's
 * `#anchor` is not a special case anyone has to know about.
 *
 * WHAT IT DRAWS, AND WHEN. Three panels or none:
 *
 *   3 featured    the band
 *   0 featured    the empty state, and no panels
 *   1–2 featured  nothing, and `W-BAND-PARTIAL` says so
 *   4+ featured   the build fails at `B-BAND-COUNT` before reaching here
 *
 * The band is a composition of three, not a list that happens to hold three:
 * two panels across the full bleed is a different object, and four is a grid.
 * So a count it cannot compose is not drawn small — it is not drawn.
 */
import { pad2, workFigure, workHref } from '../../lib/content/derive.ts';
import type { Work } from '../../lib/content/schema.ts';
import { ui } from '../../lib/content/ui.ts';

interface Props {
  /** Featured shipping works, in running order. */
  works: readonly Work[];
}

const { works } = Astro.props;
const BAND_PANELS = 3;
const panels = works.length === BAND_PANELS ? works : [];
const empty = works.length === 0;
---

{
  (panels.length > 0 || empty) && (
    <section class="s-tight" data-homepage-role="band">
      <div class="page">
        <div class="tr">
          <div class="bleed">
            {
              empty ? (
                <div class="mfs empty0">{ui.empty.triptych}</div>
              ) : (
                <div class="mfs">
                  {panels.map((w, i) => (
                    <a class="mf" href={workHref(w.slug, false)} data-w={w.slug} data-band-panel>
                      <span class="sq" />
                      <span class="n">{pad2(i + 1)} — {w.title}</span>
                      <span class="ty">{w.productType}</span>
                      <span class="lg">{w.languages.join(' · ')}</span>
                      <span class="strip">
                        <span class="crop">
                          <img
                            src={workFigure(w).src}
                            width={workFigure(w).width}
                            height={workFigure(w).height}
                            alt={w.title}
                            loading="eager"
                          />
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>
  )
}
