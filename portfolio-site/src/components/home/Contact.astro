---
/**
 * 05 CONTACT — 相談の入口。
 *
 * ここへは nav・HERO の第 2 CTA・ページ末尾の 3 経路で着く。
 *
 * 2 つのチャネルは役割が違う。Email は相談の窓口、GitHub は実装の確認先で、
 * GitHub の CTA が「GitHub で実装を見る」であって「連絡する」でないのは
 * その区別そのものである（GitHub プロフィールに受信箱は無い）。
 *
 * 公開 Email は本人しか Authority を持たない user-fact で、承認記録を持つ
 * copy registry から取る。`site.json` には承認の記録が無いため、そこへ書いた
 * 住所は誰の承認も無いまま出荷される。
 *
 * 補助文（#34）は、その Email へ何を書いて送ればよいかを 1 文で案内する。
 * 見積り・返信期限・対応可能時期のような、本人が約束していないことは言わない。
 *
 * band が反転するのは、スクロールに床を作るため。FOOTER は別の要素で別の仕事
 * ——こちらは依頼を受け取り、あちらはサイトを名乗る。
 */
import { copyText } from '../../lib/content/copy.ts';
import { sectionNumber } from '../../lib/content/derive.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';

const c = site.contact;
const index = sectionNumber('contact');

/**
 * 住所と、それが何のための窓口かを言うラベル。どちらも copy registry から
 * 取る——承認者の記録を持つのは registry だけで、`site.json` に書いた住所は
 * 承認の記録を持たないまま公開面に出る。
 */
const email = await copyText('home.contact.email');
const emailKey = await copyText('home.contact.emailKey');

/** 送る前に何を書けばよいかを示す 1 文（#34）。 */
const helper = await copyText('home.contact.helper');

/** 値が素のホスト名／パスで、https に解決して差し支えない行。 */
const hrefOf = (value: string): string | null =>
  /^[a-z0-9.-]+\.[a-z]{2,}(\/[\w./-]*)?$/i.test(value) ? `https://${value}` : null;

const rows = c.rows.map((row) => ({ ...row, href: hrefOf(row.value) }));

/**
 * CTA は URL 直書きではなく profile 行を指す——2 行のうち 1 つは本人の
 * アカウント、もう 1 つはこのリポジトリで、いま読んでいるページのソースへ
 * 着地する方は CTA が指すべき行ではない。解決しなければ null になり、
 * 行き先の無い CTA は描かれない。
 */
const github = rows.find((row) => row.key === 'GitHub')?.href ?? null;
---

<section class="contact inv" id="contact" data-mx-n={index}>
  <div class="page">
    <div class="in">
      <div class="tr">
        <Rail index={index} labels={c.railLabels} />
        <div class="msr">
          <h2 class="ct-h">{c.h2}</h2>
          <p class="lede m0 ct-l">{c.lede}</p>

          {/*
            補助文は lede の続きとして置く。主 CTA より弱い `note` の組みで、
            読む順は「何を書けばよいか」→「どこへ送るか」→「送る」になる。
          */}
          <p class="note ct-hp">{helper}</p>

          {/*
            まず依頼、次に確認。住所とその CTA を GitHub ブロックより前に置く
            のは、2 つが答えている問いが違い、この節の目的はそのうち片方だけ
            だからである。連絡すると決めた読み手に、ソースコードの説明を読み
            越えてから連絡先を探させない。
          */}
          <dl class="ct-d ct-mail">
            <dt>{emailKey}</dt>
            <dd><a href={`mailto:${email}`}>{email}</a></dd>
          </dl>
          <p class="ct-cta">
            <a class="lk" href={`mailto:${email}`}>
              {ui.contact.emailCta}<span class="ar">→</span>
            </a>
          </p>

          {/*
            2 つ目のブロックは「読む」ための導線で、リンクを出す前にそれを
            自分の言葉で言う。返信を示唆する語はここに置かない。
          */}
          <p class="note ct-ch">{ui.contact.channels}</p>
          <dl class="ct-d">
            {
              rows.map((row) => (
                <>
                  <dt>{row.key}</dt>
                  <dd>
                    {row.href ? <a href={row.href}>{row.value}</a> : row.value}
                  </dd>
                </>
              ))
            }
          </dl>
          {
            github && (
              <p class="ct-cta">
                <a class="lk lk-q" href={github}>
                  {ui.contact.githubCta}<span class="ar">→</span>
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
