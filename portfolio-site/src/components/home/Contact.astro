---
/**
 * 05 CONTACT — the conversion point.
 *
 * Three routes reach it and this is the third: the nav (`site.sections` gives
 * `contact` a label now), the hero's secondary CTA, and the end of the page.
 * Before #7 there were none — the section existed, carried two URLs as plain
 * text, and was not in the nav.
 *
 * THE URLS ARE LINKS NOW. They were `<dd>github.com/…</dd>`: the address of a
 * place, printed, with no way to go there. That is not a stylistic gap, it is
 * a contact section that cannot be used.
 *
 * NO EMAIL, AND #8 DID NOT ADD ONE. #6 searched the repository and the site and
 * found no address the owner publishes as a contact — only `@example.com`
 * fixtures. Publishing one anyway, or reusing a git commit address, would be
 * this site deciding on someone's behalf which of their addresses is public.
 * U-01 is still open, and an open question is not a reason to ship a guess: the
 * section carries the channels that exist and no placeholder for the one that
 * does not.
 *
 * WHAT THE GITHUB CTA DOES NOT SAY. It says "GitHubを見る", not "連絡する". A
 * GitHub profile is a place to read what someone has published; it has no
 * inbox. A button promising a message would be the same invention as an
 * invented address, wearing a verb instead of an @ sign (#8 §6).
 *
 * The band inverts, as it did before — it gives the scroll a floor. The FOOTER
 * is a separate element with a separate job: this asks for something, that
 * identifies the site.
 */
import { sectionNumber } from '../../lib/content/derive.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';
import Rail from '../layout/Rail.astro';

const c = site.contact;
const index = sectionNumber('contact');

/** A row whose value is a bare host/path we can safely resolve to https. */
const hrefOf = (value: string): string | null =>
  /^[a-z0-9.-]+\.[a-z]{2,}(\/[\w./-]*)?$/i.test(value) ? `https://${value}` : null;

const rows = c.rows.map((row) => ({ ...row, href: hrefOf(row.value) }));

/**
 * The CTA points at the profile row, not at a hardcoded URL — one row is the
 * owner's account and the other is this repository, and a button labelled
 * "GitHubを見る" that landed on the source of the page you are already reading
 * would be the wrong one of the two. Null when no row resolves, which is what
 * keeps the CTA from rendering with nowhere to go.
 */
const github = rows.find((row) => row.key === 'GitHub')?.href ?? null;
---

<section class="contact inv" id="contact" data-mx-n={index}>
  <div class="page">
    <div class="in">
      <div class="tr">
        <Rail index={index} labels={c.railLabels} />
        <div class="msr">
          <h2 class="ct-h">{c.h2}</h2>
          <p class="lede m0 ct-l">{c.lede}</p>
          <p class="note ct-ch">{ui.contact.channels}</p>
          <dl class="ct-d">
            {
              rows.map((row) => (
                <>
                  <dt>{row.key}</dt>
                  <dd>
                    {row.href ? <a href={row.href}>{row.value}</a> : row.value}
                  </dd>
                </>
              ))
            }
          </dl>
          {
            github && (
              <p class="ct-cta">
                <a class="lk" href={github}>
                  {ui.contact.githubCta}<span class="ar">→</span>
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
