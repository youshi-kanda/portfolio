---
/**
 * The page shell.
 *
 * `.ad` is the design-system scope: every selector in the frozen stylesheet is
 * written against it, so the wrapper is kept rather than rewriting 1,493
 * declarations to drop one class.
 *
 * `data-t="light"` matches the frozen screens. The dark token set is present
 * and correct in tokens.css, but the prototype never auto-switched on
 * `prefers-color-scheme` and turning it on here would change what a visitor
 * sees — a visual decision, not an implementation one. Wiring the switch is
 * IMPLEMENT-02 work.
 */
import '../styles/index.css';
/* The art-direction layer, imported as its own stylesheet and second on
   purpose. index.css explains why (lightningcss folds `animation-timeline`
   into the `animation` shorthand and kills every scroll timeline); the order
   matters because index.css's `@layer` statement is what places `motion`
   between `components` and `utilities`, and a layer order is fixed by the
   first declaration the document sees. */
import '../styles/motion.css';
/* Small, late-stage visual corrections live outside the frozen sheets so the
   original art-direction remains auditable. */
import '../styles/polish.css';
/* #46 — the homepage section markers. Its own sheet rather than more of
   polish.css: that file is corrections to things that already exist, and this
   is a layer that did not. Imported here, alongside motion.css, rather than
   from index.css, because it has to win over the folio rule in motion.css:
   both declare into `utilities` / `motion`, and index.css's `@layer` statement
   is what orders them — a sheet imported into `utilities` from index.css would
   be ordered the same way, but keeping the two #46 sheets' successor next to
   the layer it overrides is what makes that relationship readable. */
import '../styles/section-marker.css';
import { site } from '../lib/content/site.ts';

interface Props {
  title: string;
  description: string;
  /**
   * The 404 document, which is not a URL.
   *
   * It is emitted once, to `dist/404.html`, and nginx serves it in response to
   * whatever address the visitor actually typed. So neither of the two things
   * this layout normally states about a page can be stated truthfully here: a
   * canonical of `/404/` names a route that is not the one being served and
   * asks a crawler to index the error document, and a canonical of the typed
   * URL would point at an address that 404s. `og:url` is the same claim again,
   * for a page nobody shares.
   *
   * So the error document emits neither, and `check-links` asserts their
   * absence rather than merely tolerating it. No `noindex` either: the correct
   * signal for a page that does not exist is the 404 status nginx sends with
   * it, and a `noindex` marker in the artifact is the thing §4 exists to catch.
   */
  errorDocument?: boolean;
}

const { title, description, errorDocument = false } = Astro.props;

/**
 * The canonical URL for this page.
 *
 * `Astro.site` is the single declared origin (astro.config.mjs). It is read
 * rather than defaulted: a missing `site` used to fall back to
 * `https://example.invalid`, which produced eight canonical links and — now —
 * eight og:url values pointing at a domain that is not this one. A build that
 * cannot state where it will be served should stop, not guess.
 */
if (!Astro.site) {
  throw new Error('astro.config.mjs に site が無い（canonical / og:url / sitemap の正本）');
}
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/og-card.png', Astro.site).href;
const socialImageAlt = `${site.handle} Engineering Portfolio`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="format-detection" content="address=no" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F4F2ED" />
    {!errorDocument && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    {/*
      Open Graph / social preview.

      The card is a dedicated portfolio identity graphic, not a repurposed
      Evidence screenshot. It contains only the owner handle and the same broad
      capability categories already stated by the page, so sharing the URL does
      not detach a product screenshot from its provenance or invent a result.
      The SVG source is kept in scripts/assets; predev/prebuild render a
      1200×630 PNG for broad crawler compatibility.
    */}
    {
      !errorDocument && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:site_name" content={site.handle} />
          <meta property="og:locale" content="ja_JP" />
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:alt" content={socialImageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImage} />
          <meta name="twitter:image:alt" content={socialImageAlt} />
        </>
      )
    }

    <title>{title}</title>
  </head>
  <body>
    <div class="ad" data-t="light">
      <slot />
    </div>
    <span hidden data-repo={site.repo}></span>
  </body>
</html>
