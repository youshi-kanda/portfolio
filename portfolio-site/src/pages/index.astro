---
/**
 * The homepage — the Editorial Gallery (#7, spec docs/design/home-ia-content-spec.md).
 *
 *   00 HERO / 01 FEATURED WORK / 02 MORE PROJECTS / 03 CAPABILITIES /
 *   04 ABOUT / 05 CONTACT / 06 FOOTER
 *
 * WHAT LEFT, AND WHY IT IS NOT A DELETION. The Editorial Band and the Lead
 * entry are gone from this page. Both showed the same works the index below
 * them already showed, so the page introduced three works three times; the
 * spec's rule is that a work is introduced once. The depth the Lead carried
 * moves to the Case Study, which is where a reader who wants it has already
 * asked for it.
 *
 * 03 ENGINEERING STACK, 04 ENGINEERING PRINCIPLES and 05 FEATURED EVIDENCE are
 * still components holding their content in `site.json`, still under every
 * gate, and still not rendered here. HOW I BUILD joins them: its long form is
 * now a page of its own at /how-i-build/, and CAPABILITIES carries the one line
 * plus the link.
 *
 * THE SYNTHETIC-DATA BAND LEFT THE FIRST VIEWPORT, and did not leave the site.
 * It was the second thing a visitor read — a disclaimer, above any statement of
 * what this engineer builds. The statement now sits where it is actually about
 * something: on every figure's own caption in 01 FEATURED WORK, and in 04
 * ABOUT's premises. The strip stays on the pages that ARE the screens it
 * qualifies — /work/<slug>/, their technical pages, /how-i-build/ and /404.
 *
 * NOT ON /work/, despite what this comment said until #8. The archive lists
 * works; it renders no screen, so there was nothing there for the strip to
 * qualify and #7 did not give it one. The claim was wrong in the audit and in
 * a PR description before anyone checked which routes mount `SyntheticBar`.
 *
 * The numbers above are not written anywhere. `site.sections` is the running
 * order and every index is its position in it, so changing that array
 * renumbers the sections and the nav in one edit.
 */
import { getCollection } from 'astro:content';
import About from '../components/home/About.astro';
import Capabilities from '../components/home/Capabilities.astro';
import Contact from '../components/home/Contact.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import Hero from '../components/home/Hero.astro';
import MoreProjects from '../components/home/MoreProjects.astro';
import EvidenceDialog from '../components/evidence/EvidenceDialog.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/navigation/MobileBar.astro';
import MotionStage from '../components/motion/MotionStage.astro';
import Nav from '../components/navigation/Nav.astro';

import BaseLayout from '../layouts/BaseLayout.astro';
import { copyText } from '../lib/content/copy.ts';
import {
  featuredHomepageWorks,
  shippingWorks,
} from '../lib/content/derive.ts';
import { site } from '../lib/content/site.ts';

/*
  THE LEAD A/B IS GONE. `lib/review/lead-candidate.ts` existed to photograph two
  answers to "which work should the homepage lead with". #7 retired the Lead, so
  the question it settled no longer exists — and a review path that still
  reordered a list nothing reads would be a switch with nothing on the other end.
  The decision it recorded (V4 Phase 5, Lead = AI CRM) survives as
  `homepageRole` on the record.
*/
const all = (await getCollection('work')).map((e) => e.data);
const works = shippingWorks(all);
const featured = featuredHomepageWorks(all);
/** The same sentence the hero prints, so the tab and the page do not disagree. */
const description = await copyText('home.hero.lede');
---

{/*
  The homepage title was the handle alone, which is unique but says nothing:
  in a search result or a browser tab it names the author and not the page.
  Pairing it with the kicker is the masthead's own composition — Nav renders
  `{site.handle}<i>{site.kicker}</i>` — so the tab and the top of the page now
  read the same. Both halves are existing site facts; no copy was authored for
  the title.
*/}
<BaseLayout title={`${site.handle} — ${site.kicker}`} description={description}>
  <Nav progress={6} hasWorks={works.length > 0} />
  {/*
    Motion prototype (feature/motion-experience-v2), scoped to 00 and 01.
    Placed before <main> on purpose: its inline gate script has to set the
    reduced-motion flag before the hero is parsed, or the elements that start
    hidden paint once at full size first.
  */}
  <MotionStage />
  <main>
    <Hero />
    <FeaturedWork works={featured} />
    <MoreProjects works={all} />
    <Capabilities works={all} />
    <About />
    <Contact />
    <Footer />
  </main>
  <MobileBar />
  <EvidenceDialog />
</BaseLayout>
