---
/**
 * /work/ — the archive. Every work the site ships, including the ones on
 * neither homepage tier.
 *
 * #7 TOOK THE MACHINE OFF THIS PAGE. It used to end with a variant assignment
 * table: one row per work, printing `entryVariant`, `caseVariant` and the
 * pigment name, under a note stating the diversity floor the build enforces.
 * That is the rendering contract talking to itself in public. `v-terminal` is
 * the name of a renderer; a visitor reading it learns nothing about the work
 * and something about our source tree.
 *
 * The gate that table described is untouched — `variantGate` still refuses a
 * register that degenerates into one layout, and `/work/` is still where the
 * count it uses comes from. It simply no longer reports its own workings to
 * the reader. Not displayed and not verified are different states.
 *
 * Rows link only where `/work/<slug>/` exists (see Register.astro).
 */

import { getCollection } from 'astro:content';
import EvidenceDialog from '../../components/evidence/EvidenceDialog.astro';
import Footer from '../../components/layout/Footer.astro';
import Rail from '../../components/layout/Rail.astro';
import SyntheticBar from '../../components/layout/SyntheticBar.astro';
import Nav from '../../components/navigation/Nav.astro';
import Register from '../../components/work/Register.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shippingWorks } from '../../lib/content/derive.ts';
import { fill, ui } from '../../lib/content/ui.ts';

const works = shippingWorks((await getCollection('work')).map((e) => e.data));
const evidence = (await getCollection('evidence')).map((e) => e.data);
---

<BaseLayout
  title={`WORK INDEX — ${fill(ui.register.h1, { count: works.length })}`}
  description={ui.register.lede}
>
  <Nav current="WORK" progress={20} hasWorks={works.length > 0} onHomepage={false} />
  <SyntheticBar />
  <main id="register">
    <section class="hero">
      <div class="page">
        <div class="tr">
          <Rail
            index={String(works.length)}
            labels={ui.register.railLabels}
            note={ui.register.railNote}
          />
          <div class="msr">
            <h1 class="dsp-s">{fill(ui.register.h1, { count: works.length })}</h1>
            <p class="lede">{ui.register.lede}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="s-tight">
      <div class="page">
        <div class="tr">
          <div class="bleed">
            <div class="page"><Register works={works} evidence={evidence} /></div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
  <EvidenceDialog />
</BaseLayout>
