---
/**
 * /work/ — the archive. Every work the site ships, including the ones on
 * neither homepage tier.
 *
 * #7 TOOK THE MACHINE OFF THIS PAGE. It used to end with a variant assignment
 * table: one row per work, printing the entry variant, the case variant and the
 * pigment name, under a note stating the diversity floor the build enforced.
 * That is the rendering contract talking to itself in public. `v-terminal` was
 * the name of a renderer; a visitor reading it learned nothing about the work
 * and something about our source tree.
 *
 * The entry variant no longer exists at all — the Overview checkpoint retired
 * the renderers, the field and the gate together — so the table's `entry (L2)`
 * header and its explanatory note were deleted from the registry with them.
 *
 * #7 VISUAL REVIEW TOOK THE REST OF IT OFF THE HEADER. The table was gone but
 * the hero still opened with the same voice: a heading that promised the index
 * 「同じ規則で 20 件まで伸びる」 and a four-sentence lede on row composition,
 * declared-in-content ordering and what the build refuses. Those sentences are
 * true and they are about the site's implementation, not about the work — the
 * first thing a reader met on the archive was our validation design. The header
 * is now the count and the name of the page, nothing else.
 *
 * `ui.register.h1`, `.lede` and `.railNote` ARE NOT DELETED. They stay in
 * `ui.ts` and in `src/content/copy/ui.json`, registered and approved, so the
 * copy gate still holds them (U-UNMANAGED / U-DRIFT are unchanged and no gate
 * was relaxed to land this). Not rendered and not registered are different
 * states, and what changed in #7 was only which registered strings this page
 * draws.
 *
 * That is a different case from the two variant rows the Overview checkpoint
 * deleted, and the line worth keeping straight: these three describe THIS page,
 * which still exists and could show them again tomorrow. `entry (L2)` and
 * `variantNote` described a specification that has been retired, so there is
 * nothing left for them to be the copy of.
 *
 * No copy was authored for the replacement. The h1 reuses `railLabels[0]`, the
 * label already approved for this page under exactly this name; the count is
 * derived from `works.length` as it always was; the description reuses the
 * approved homepage WORK heading, which asks the question this list answers.
 *
 * THE SYNTHETIC BAR IS NOT ON THIS PAGE. It states that the SCREENS are
 * synthetic, and this page renders no screens — `Register` draws no thumbnail
 * (see Register.astro). A disclaimer whose subject is absent still occupies the
 * first band under the masthead, so the archive led with a caveat about images
 * it does not show. The bar is untouched everywhere it has a subject: the work
 * entry pages, the Case Studies, /how-i-build/ and /404.html all keep it, and
 * `site.synthetic` is unchanged.
 *
 * Every row links: since the Overview checkpoint `/work/<slug>/` is emitted for
 * every shipping work, and `Register` still asks rather than assuming (see
 * Register.astro).
 */

import { getCollection } from 'astro:content';
import EvidenceDialog from '../../components/evidence/EvidenceDialog.astro';
import Footer from '../../components/layout/Footer.astro';
import Rail from '../../components/layout/Rail.astro';
import Nav from '../../components/navigation/Nav.astro';
import Register from '../../components/work/Register.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copyText } from '../../lib/content/copy.ts';
import { shippingWorks } from '../../lib/content/derive.ts';
import { site } from '../../lib/content/site.ts';
import { ui } from '../../lib/content/ui.ts';

const works = shippingWorks((await getCollection('work')).map((e) => e.data));

/** The page's own name, from the rail label registered for it. */
const h1 = ui.register.railLabels[0];
/**
 * The meta description. `ui.register.lede` used to fill this slot, which put
 * the build's refusal rules into the tab title's neighbour and into a search
 * result. This is the approved homepage WORK heading — the question this
 * archive is a list of answers to.
 */
const description = await copyText('home.works.h2');
---

<BaseLayout title={`${h1} — ${site.handle}`} description={description}>
  <Nav progress={20} hasWorks={works.length > 0} onHomepage={false} />
  <main id="register">
    <section class="hero">
      <div class="page">
        <div class="tr">
          {/* The count alone. `Register` and `0 → 20 works` were the other two
              rail lines; both described the register as a mechanism. */}
          <Rail index={String(works.length)} />
          <div class="msr">
            <h1 class="dsp-s">{h1}</h1>
          </div>
        </div>
      </div>
    </section>

    <section class="s-tight">
      <div class="page">
        <div class="tr">
          <div class="bleed">
            <div class="page"><Register works={works} /></div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
  <EvidenceDialog />
</BaseLayout>
