---
/**
 * /work/<slug>/ — every shipping work's page. The Case Study where one has been
 * written, the Overview where one has not.
 *
 * THE EVIDENCE GATE IS GONE (Overview checkpoint). This route used to return
 * `[]` for any work whose first Evidence id did not resolve, so seven of the
 * ten shipping works had no page: the archive listed them and could not link
 * them, and nothing anywhere introduced them. The condition read as caution —
 * do not draw a screen we cannot source — but what it actually decided was
 * whether a WORK is published, on the evidence of whether a SCREENSHOT is.
 *
 * Those are four separate questions and `derive.ts` now keeps them apart:
 * the work exists, its Evidence exists, its Case Study exists, its Technical
 * page exists. This route asks only the first. `WorkOverview` draws what the
 * work record says and no more; where there is no image it shows no image,
 * which is a page about a work rather than a hole where a screen should be.
 *
 * Nothing here names a work. The sections come from what the content has and
 * the Evidence comes from the ids the work and its Case Study cite — add an
 * eleventh work and this file is untouched.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import CaseBody from '../../../components/case/CaseBody.astro';
import CaseContents from '../../../components/case/CaseContents.astro';
import CaseHead from '../../../components/case/CaseHead.astro';
import CaseSpine from '../../../components/case/CaseSpine.astro';
import EvidenceDialog from '../../../components/evidence/EvidenceDialog.astro';
import Footer from '../../../components/layout/Footer.astro';
import Rail from '../../../components/layout/Rail.astro';
import SyntheticBar from '../../../components/layout/SyntheticBar.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import Nav from '../../../components/navigation/Nav.astro';
import PageBar from '../../../components/navigation/PageBar.astro';
import ReturnBand from '../../../components/navigation/ReturnBand.astro';
import WorkOverview from '../../../components/work/WorkOverview.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  ARCHIVE_HREF,
  caseSections,
  shippingWorks,
  technicalHref,
  workCrumbs,
  workHasFigure,
  workHasTechnical,
} from '../../../lib/content/derive.ts';
import { ui } from '../../../lib/content/ui.ts';

export const getStaticPaths = (async () => {
  // `shippingWorks` IS the whole condition — it is `workHasOverview` applied to
  // the collection, and `routes.ts` and `Register` restate the same predicate
  // so the sitemap, the archive's links and this list cannot disagree.
  const works = shippingWorks((await getCollection('work')).map((e) => e.data));
  const evidence = (await getCollection('evidence')).map((e) => e.data);
  const caseStudies = (await getCollection('caseStudy')).map((e) => e.data);
  const bySlug = new Map(caseStudies.map((c) => [c.slug, c]));

  return works.map((work) => ({
    params: { slug: work.slug },
    props: {
      work,
      allEvidence: evidence,
      caseStudy: bySlug.get(work.slug) ?? null,
      hasTechnical: workHasTechnical(work, caseStudies),
    },
  }));
}) satisfies GetStaticPaths;

const { work, allEvidence, caseStudy, hasTechnical } = Astro.props;

const description = caseStudy ? caseStudy.overview : work.purpose;
const sections = caseStudy ? caseSections(work, caseStudy) : [];

/**
 * The synthetic-data strip states that the SCREENS on this page are synthetic.
 * A Case Study always shows screens; an Overview shows one only when the work
 * has an image, and `minio`, `docai` and `agri` have none. A disclaimer whose
 * subject is absent is the defect /work/ removed from its own header in #7, so
 * it is rendered on the same terms here: where there is something to disclaim.
 */
const showsScreens = caseStudy !== null || workHasFigure(work);

/**
 * WAYFINDING IS NOT CONDITIONAL ON CONTENT (#11 §8), and this checkpoint is
 * where that contract gets paid.
 *
 * The trail, the return band and the bar are computed from the work and its
 * route. Seven works arrived with no Case Study, no Evidence and no image, and
 * not one line below changed to accommodate them: the same crumb, the same
 * 「作品一覧に戻る」, the same WORK INDEX bar.
 *
 * What does vary is whether there is anywhere DEEPER to go, and that is a fact
 * about the Technical route rather than about this page's contents. It is
 * asked once, by the same predicate `technical.astro` gates itself on, so the
 * Overview cannot offer a link to a page that was not emitted.
 */
const archiveLabel = ui.register.railLabels[0];
const crumbs = workCrumbs(archiveLabel, work.title, work.slug);
const deeper = hasTechnical ? technicalHref(work.slug) : null;

const returnLinks = [
  { label: ui.work.backToIndex, href: ARCHIVE_HREF, back: true },
  ...(deeper ? [{ label: ui.caseStudy.technicalCta, href: deeper, back: false }] : []),
];
---

<BaseLayout title={`${work.title} — ${work.productType}`} description={description}>
  <Nav progress={32} onHomepage={false} />
  <Breadcrumb crumbs={crumbs} />
  {showsScreens && <SyntheticBar />}
  <main data-w={work.slug}>
    {
      caseStudy ? (
        <>
          <CaseHead work={work} caseStudy={caseStudy} />

          {/*
            The spine, in this work's declared case variant.

            Its rail is empty on purpose (#8 §7). It used to carry the variant
            name — `walkthrough`, `ledger`, `pipeline` — which selects HOW this
            block is drawn and says nothing about the work; printing it labelled
            the reader's view of the system with the name of a template. The
            spine belongs to the opening section above it and takes no number of
            its own, so what is left is the gutter, the same way 03 CAPABILITIES
            leaves it on the homepage.
          */}
          {caseStudy.flow.length > 0 && (
            <section class="s-open">
              <div class="page">
                <div class="tr">
                  <div class="ins" />
                  <div class="fld">
                    <CaseSpine work={work} caseStudy={caseStudy} />
                  </div>
                </div>
              </div>
            </section>
          )}

          <CaseBody work={work} caseStudy={caseStudy} evidence={allEvidence} />
          <CaseContents entries={sections} />
        </>
      ) : (
        <>
          <section class="hero">
            <div class="page">
              <div class="tr">
                {/*
                  The same rail the Case Study and Technical pages draw:
                  index, the page's own name, the work. It used to read
                  `01 SELECTED WORK / Entry — {title}`, which named a homepage
                  band renamed in #7 and then printed the title a second time
                  directly above the h1.
                */}
                <Rail index={ui.workPage.railIndex} labels={[...ui.workPage.railLabels, work.title]} />
                <div class="msr">
                  {/*
                    Same shape as the Case Study hero (#11 §4): the h1 is the
                    work, the product type is the kicker above it. Seven works
                    reach this branch and each one now names itself in the
                    largest text on its own page.
                  */}
                  <p class="mo ty">{work.productType}</p>
                  <h1 class="dsp-s">{work.title}</h1>
                  <p class="lede m0">{work.purpose}</p>
                </div>
              </div>
            </div>
          </section>
          <WorkOverview work={work} />
        </>
      )
    }
    <ReturnBand links={returnLinks} />
    <Footer />
  </main>
  <PageBar
    up={{ label: archiveLabel, href: ARCHIVE_HREF }}
    down={deeper ? { label: ui.technical.railLabels[0], href: deeper } : null}
  />
  <EvidenceDialog />
</BaseLayout>
