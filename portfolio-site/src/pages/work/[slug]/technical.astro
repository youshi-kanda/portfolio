---
/**
 * /work/<slug>/technical/ — the implementation judgment page.
 *
 * Not a stack list. §9's rule, and the reason the sections are T-1 … T-8 rather
 * than "Frontend / Backend / Infra": a list of technologies says what was used,
 * which the register already says. What is worth a page is why this shape was
 * chosen over the ones that were rejected, how it fails, and what that cost.
 *
 * design-freeze §1 item 9 fixes the layout as a section index rail beside the
 * body, so the rail here is that index — built from the sections this work
 * actually has, for the same reason the Case Study's table of contents is.
 *
 * Only works with a Case Study get this route. The technical content lives on
 * the Case Study record, so a work without one has nothing to put here, and a
 * page of empty headings is worse than no page — `technicalHref` is only ever
 * rendered from the Case Study itself, so no link points at the gap.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import EvidenceDialog from '../../../components/evidence/EvidenceDialog.astro';
import Footer from '../../../components/layout/Footer.astro';
import Rail from '../../../components/layout/Rail.astro';
import SectionHead from '../../../components/layout/SectionHead.astro';
import SyntheticBar from '../../../components/layout/SyntheticBar.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import Nav from '../../../components/navigation/Nav.astro';
import ReturnBand from '../../../components/navigation/ReturnBand.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { workRepoPath, workVerification } from '../../../lib/content/compat.ts';
import {
  ARCHIVE_HREF,
  contactHref,
  pad2,
  shippingWorks,
  workCrumbs,
  workHref,
} from '../../../lib/content/derive.ts';
import { site } from '../../../lib/content/site.ts';
import { fill, ui } from '../../../lib/content/ui.ts';

export const getStaticPaths = (async () => {
  const works = shippingWorks((await getCollection('work')).map((e) => e.data));
  const caseStudies = (await getCollection('caseStudy')).map((e) => e.data);
  const bySlug = new Map(caseStudies.map((c) => [c.slug, c]));

  return works.flatMap((work) => {
    const caseStudy = bySlug.get(work.slug);
    return caseStudy ? [{ params: { slug: work.slug }, props: { work, caseStudy } }] : [];
  });
}) satisfies GetStaticPaths;

const { work, caseStudy } = Astro.props;
const t = caseStudy.technical;
const S = ui.technical.sections;
const A = ui.technical.aboutFields;

/**
 * The sections this work has content for, in T order. The rail lists these and
 * the body renders these, from one array — an index entry whose section was
 * dropped for being empty is a dead anchor.
 */
/*
 * NUMBERED BY POSITION, NOT BY SPEC ID (#8 §7).
 *
 * These were `T-0` … `T-8` with a `CS-13` wedged in at the eighth slot. Both
 * are internal coordinates — design-freeze §1 item 9 names the T sections, the
 * case-study spec names CS-13 — and the seam showed: a reader counting down a
 * T run met one entry from a different document, numbered out of a series they
 * had not been shown. The Scale table is on this page because it belongs here,
 * and carrying its filing reference across was how that borrowing became
 * visible to someone who cannot look either document up.
 *
 * `id` — the anchor — is untouched, so `#t5` and `#scale` still resolve.
 */
const sections = (
  [
    ['t0', S.about, true],
    ['t1', S.architecture, t.architectureSummary.length > 0],
    ['t2', S.why, t.whyThisArchitecture.length > 0],
    ['t3', S.failureModes, t.failureModes.length > 0],
    ['t4', S.tradeOffs, t.tradeOffs.length > 0],
    ['t5', S.tests, t.testsSummary.length > 0],
    ['t6', S.security, t.security.length > 0],
    ['t7', S.limitations, t.limitationsNote.length > 0],
    ['scale', S.scale, caseStudy.scale.length > 0],
    ['t8', S.links, t.links.length > 0],
  ] as [string, string, boolean][]
)
  .filter(([, , on]) => on)
  .map(([id, title], i) => ({ id, index: pad2(i + 1), title }));

const has = (id: string): boolean => sections.some((s) => s.id === id);
const no = new Map(sections.map((s) => [s.id, s.index]));
/** Empty only for a section `has()` already refused, which never renders. */
const ix = (id: string): string => no.get(id) ?? '';

const tests = workVerification(work);
const repoPath = workRepoPath(work);
/**
 * Where the claims on this page can be read back. A work with no public path
 * has no public README to name, and naming one that cannot be opened would be
 * a citation the reader cannot follow.
 */
const claimSource = repoPath ? `${repoPath}README.md` : null;

/**
 * Wayfinding. None of it reads `t`: the way back out of a page may not depend
 * on what the page happens to contain — see the note where the Links section's
 * CTA used to be.
 */
const archiveLabel = ui.register.pageTitle;
const parentHref = workHref(work.slug, false);
const crumbs = workCrumbs(archiveLabel, work.title, work.slug, ui.technical.railLabels[0] as string);

const contactLabel = site.sections.find((s) => s.id === 'contact')?.label as string;
const returnLinks = [
  { label: fill(ui.work.backToWork, { title: work.title }), href: parentHref, back: true },
  { label: ui.register.allWorksCta, href: ARCHIVE_HREF, back: false },
  { label: contactLabel, href: contactHref(), back: false },
];
---

<BaseLayout
  title={`${work.title} — ${S.architecture}`}
  description={t.architectureSummary}
>
  <Nav progress={48} onHomepage={false} />
  <Breadcrumb crumbs={crumbs} />
  <SyntheticBar />
  <main data-w={work.slug}>
    <section class="hero">
      <div class="page">
        <div class="tr">
          <Rail index="T" labels={[...ui.technical.railLabels, work.title]} />
          <div class="msr">
            <p class="mo ty">{work.productType}</p>
            <h1 class="dsp-s">{work.title}</h1>
            <p class="lede m0">{work.purpose}</p>
          </div>
        </div>
      </div>
    </section>

    {/* The section index — design-freeze §1 item 9. */}
    <section class="s-tight">
      <div class="page">
        <div class="tr">
          <div class="ins"><span class="lb">{ui.technical.sectionsLabel}</span></div>
          <div class="fld">
            <ul class="toc">
              {
                sections.map((s) => (
                  <li>
                    <span class="mo">{s.index}</span>
                    <a href={`#${s.id}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* T-0 — what this page is about, and what it is not about. */}
    <section class="s-open" id="t0">
      <div class="page">
        <div class="tr">
          <div class="ins"><span class="ix">{ix('t0')}</span><span class="lb">{S.about}</span></div>
          <div class="fld">
            <h2>{S.about}</h2>
            <div class="spx">
              <div class="r"><span class="k">{A.target}</span><span class="v">{work.title}{repoPath && `（${repoPath}）`}</span></div>
              {claimSource && (
                <div class="r"><span class="k">{A.claimSource}</span><span class="v">{claimSource}</span></div>
              )}
              <div class="r"><span class="k">{A.role}</span><span class="v">{caseStudy.role}</span></div>
            </div>
            <div class="notclaim" style="margin-top:30px">
              <h4 aria-level="3">{A.notIncluded}</h4>
              <ul>{work.originalProductScope.map((s) => <li>{s}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      has('t1') && (
        <section class="s-open" id="t1">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t1')}</span><span class="lb">{S.architecture}</span></div>
              <div class="fld">
                <h2>{S.architecture}</h2>
                <p class="lede m0">{t.architectureSummary}</p>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {/* T-2 — the sentence the whole page exists for. */}
    {
      has('t2') && (
        <section class="s-open" id="t2">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t2')}</span><span class="lb">{S.why}</span></div>
              <div class="fld">
                <h2>{S.why}</h2>
                <p class="lede">{t.whyThisArchitecture}</p>
                {t.rejected.length > 0 && (
                  <div class="dec">
                    <ul>
                      {t.rejected.map((r) => (
                        <li>
                          <h5 aria-level="3">{r.option}</h5>
                          <p class="note">{r.why}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t3') && (
        <section class="s-open" id="t3">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t3')}</span><span class="lb">{S.failureModes}</span></div>
              <div class="fld">
                <h2>{S.failureModes}</h2>
                <ol class="num">{t.failureModes.map((f) => <li>{f}</li>)}</ol>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t4') && (
        <section class="s-open" id="t4">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t4')}</span><span class="lb">{S.tradeOffs}</span></div>
              <div class="fld">
                <h2>{S.tradeOffs}</h2>
                <ul class="dash">{t.tradeOffs.map((x) => <li>{x}</li>)}</ul>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t5') && (
        <section class="s-open" id="t5">
          <div class="page">
            <div class="tr">
              <div class="ins">
                <span class="ix">{ix('t5')}</span><span class="lb">{S.tests}</span>
              </div>
              <div class="fld">
                <h2>{S.tests}</h2>
                <p class="lede">{t.testsSummary}</p>
                {tests && (
                  <p class="meta">
                    <span class="st pass">{tests.summary}</span>
                    <span class="st hold">{tests.source}</span>
                  </p>
                )}
                {t.testBreakdown.length > 0 && (
                  <div class="tw" style="margin-top:26px">
                    <table>
                      <thead>
                        <tr>{ui.technical.testBreakdownHeaders.map((h) => <th>{h}</th>)}</tr>
                      </thead>
                      <tbody>
                        {t.testBreakdown.map((b) => (
                          <tr><th>{b.area}</th><td>{b.detail}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t6') && (
        <section class="s-open" id="t6">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t6')}</span><span class="lb">{S.security}</span></div>
              <div class="fld">
                <h2>{S.security}</h2>
                <ul class="dash">{t.security.map((x) => <li>{x}</li>)}</ul>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t7') && (
        <section class="s-open" id="t7">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t7')}</span><span class="lb">{S.limitations}</span></div>
              <div class="fld">
                <h2>{S.limitations}</h2>
                <p class="note">{t.limitationsNote}</p>
                <div class="notclaim" style="margin-top:26px">
                  <h4 aria-level="3">{ui.work.scope.excluded}</h4>
                  <ul>{work.limitations.map((x) => <li>{x}</li>)}</ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('scale') && (
        <section class="s-open" id="scale">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('scale')}</span><span class="lb">{S.scale}</span></div>
              <div class="fld">
                <h2>{S.scale}</h2>
                <div class="tw">
                  <table>
                    <thead>
                      <tr>{ui.caseStudy.scaleHeaders.map((h) => <th>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {caseStudy.scale.map((s) => (
                        <tr><th>{s.item}</th><td><b>{s.value}</b></td><td>{s.method}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      has('t8') && (
        <section class="s-open" id="t8">
          <div class="page">
            <div class="tr">
              <div class="ins"><span class="ix">{ix('t8')}</span><span class="lb">{S.links}</span></div>
              <div class="fld">
                <h2>{S.links}</h2>
                <ul class="dash">{t.links.map((x) => <li><code>{x}</code></li>)}</ul>
                {t.designDocs.length > 0 && (
                  <>
                    <SectionHead label={ui.technical.designDocsHead} />
                    <ol class="num">{t.designDocs.map((d) => <li><code>{d}</code></li>)}</ol>
                  </>
                )}
                {/*
                  THE RETURN LINK IS NOT HERE ANY MORE.

                  It sat at the end of this section, reading 「Case Study を読む
                  →」, and it was the page's only route back to the work it is
                  about. Two defects in one placement:

                    it was rendered under `has('t8')`. A work whose Case Study
                    cites no source links would have shipped a Technical page
                    with no route to its parent at all — latent today only
                    because all three published works happen to cite some.

                    it looked like a list item. Between a run of file paths and
                    the footer, a page-level return reads as one more entry in
                    the Links list rather than as the way out of the page.

                  `ReturnBand` below carries it, outside every section, and says
                  which work it goes back to.
                */}
              </div>
            </div>
          </div>
        </section>
      )
    }
    <ReturnBand links={returnLinks} />
    <Footer />
  </main>
  <EvidenceDialog />
</BaseLayout>
