---
/**
 * /how-i-build/ — the method, in full.
 *
 * It used to be 2,220px of the homepage, between the work and the profile. The
 * page's job is to say what this engineer builds and show it; a reader who
 * wants the steps the work actually goes through is a reader who has already
 * decided to go deeper, and this is where they land.
 *
 * THE WORDS DID CHANGE, ONCE. When this page was cut out of the homepage it
 * rendered `HowIBuild.astro` against the same `site.json` data unaltered — the
 * component moved, the copy did not. The copy audit then found that what moved
 * was a developer's account of their own method: an eight-step workflow
 * labelled by which AI ran each step, a roles table, an Intent list and a
 * block of things the page declined to claim. It now carries the five steps a
 * client goes through, and nothing about which tool does which.
 *
 * THE DESCRIPTION IS THE PAGE'S OWN. `h.lede` fills `description`, so the meta
 * and og descriptions say what this page contains. They used to carry
 * 「AI へ実装を委譲しても、理解まで委譲しない。」 — which meant the sentence
 * shipped four times on this one page (meta, og, the h1's lede, and the first
 * Intent item) and a fifth on the homepage. It is gone from all five.
 */
import { getCollection } from 'astro:content';
import HowIBuild from '../components/home/HowIBuild.astro';
import Footer from '../components/layout/Footer.astro';
import Rail from '../components/layout/Rail.astro';
import SyntheticBar from '../components/layout/SyntheticBar.astro';
import Nav from '../components/navigation/Nav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { shippingWorks } from '../lib/content/derive.ts';
import { site } from '../lib/content/site.ts';

const works = shippingWorks((await getCollection('work')).map((e) => e.data));
const h = site.howIBuild;
---

<BaseLayout title={`HOW I BUILD — ${site.handle}`} description={h.lede}>
  <Nav progress={12} hasWorks={works.length > 0} onHomepage={false} />
  <SyntheticBar />
  <main id="how-i-build">
    {/* The page's own h1, and the ONLY place the method's title and lede are
        stated. `HowIBuild` carries the same two strings as an `<h2>` because it
        was written as a homepage section; rendering both printed the title
        twice, the lede twice and two `M` rails on the one page that uses it
        (#10). The component's head is suppressed and its rail labels are
        raised to the rail here, so nothing approved is lost. */}
    <section class="hero">
      <div class="page">
        <div class="tr">
          <Rail index="M" labels={h.railLabels} />
          <div class="msr">
            <h1 class="dsp-s">{h.title}</h1>
            <p class="lede">{h.lede}</p>
          </div>
        </div>
      </div>
    </section>
    <HowIBuild heading={false} />
    <Footer />
  </main>
</BaseLayout>
