  "keyDecision": [
    {
      "decision": "確信度をページ平均ではなくブロック単位で採点する。",
      "rationale": "ページ平均は 0.86。手書きの備考は 0.58 のブロックに乗り、乗数の後 0.49 になります。ページ平均だけ見ていると、印字された型番と滲んだ備考が同じ点数になります。"
    },
    {
      "decision": "読めなかった値は、補完せず拒否する。",
      "rationale": "欠損はページ基準値ではなく 0 点。2026-02-31 は null を返します。静かに直された値は、確認が必要だったことを人に伝えられません。"
    }
  ],
